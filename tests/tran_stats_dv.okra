	Navigate "?f=layout&module=SystemReport&name=TranscriptionStats"
	Select "Alert Comment" from the "Document Type:" field
	Click the "Exclude Selected Document Types" checkbox
	Click the "Run Query" button
	Verify exists "physician3" text
	Verify exists "butler" text
	Verify exists "selenium" text
	Verify exists "1778" text
	Verify exists "00:00:00" text
	Verify exists "00:00:06" text
	Verify exists "1215" text
	Verify exists "8" text
	Verify exists "7" text
	Verify exists "17" text
	Verify exists "25" text

