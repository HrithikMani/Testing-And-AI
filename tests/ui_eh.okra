"""
	This test is a basic test to navigate to a page and take a screenshot of the page for any changes that may affect the pages visually.
	@owners: akesler 
	@filedeps: src/nomoreclipboard.c, system/layouts/No Login/Login.html
	@systemType: EH

	READ ME:
		* This test does not have committed baselines
		to avoid constant updating of baselines.
		* To utilize this test for diffing screenshots,
		follow these steps:
			1. Run "UI/Layout Tests" WITHOUT your changes
			2. Checkout your branch
			3. Once it is finished running, move all new
			screenshots to baseline
				* `View New` blue link in the top right
				* `Move All New Screens To Baseline` link
			4. Run "UI/Layout Tests" WITH your code changes
			5. Compare any resulting screenshot diffs
			6. Delete all *_page_layout.png files when done

	Notes:
	# Do not put any additional sections after the logout section, otherwise the screenshot will just capture the logged out page.
	# Not everything is covered, if the page you've made changes to isn't here, it can be added.
"""

@@@ READ ME
readme = [
'READ ME:',
'	* This test does not have committed baselines',
'	to avoid constant updating of baselines.',
'	* To utilize this test for diffing screenshots,',
'	follow these steps:',
'		1. Run "UI/Layout Tests" WITHOUT your changes',
'		2. Once it is finished running, move all new',
'		screenshots to baseline',
'		3. Run "UI/Layout Tests" WITH your code changes',
'		4. Compare any resulting screenshot diffs',
'		5. Delete all *_page_layout.png files when done'
]
driver.addHeaderItem('UI Test - Read Me', readme)
@@@
Begin "DO NOT COMMIT DIFFS TO BASELINE - See 'READ ME' for instructions"
Begin "UI Appearance Test"
	Begin "sidemenu Page Layout"
		Navigate '?func=omniscope'
		Begin "Setup"
	# Place any necessary setup other than "Navigate" within this "Setup" section
	@@@Wait for page
	driver.pause(10)
	wd = driver.getWebDriver()
	from selenium.webdriver.common.action_chains import ActionChains
	ActionChains(wd).move_to_element_with_offset(driver.getElement(xpath='//body'), 2, 2).perform()
	@@@
