Begin "FOH Testing Setting Changes and Setup"
	Open the sidemenu
	Click the "Control Panel" sidemenu entry
	Click the "Access" charttab
	Click the "My Settings" link
	Select No from the "Use Popup for Patient Links" dropdown
	Click the "Submit Settings" button
	Open the sidemenu
	Click the "Control Panel" sidemenu entry
	Click the "Access" charttab
	Click the "Access Control" link
	Type "Selenium" in the "search" input
	Click the "Go!" button
	# Change this next line when something is implemented to Okra allow something more specific for a listview.
	# Also, Okra sees all other "Editor" as "Edit" links, hence why it is 7th or !exact match
	Click the 1st !Edit link
	Select Fiscal from the "realm" dropdown
	Click the "Submit" button
	Verify exists "User (selenium) was updated successfully" text
	Click the 1st !Edit link
	Click the "Customize User Security" link
	Select "Yes" from the "Control_Manage Contacts" dropdown
	Select "Edit" from the "WebChart_Manage Encounter Charges" dropdown
	Select "Yes" from the "Manage Accounts" dropdown
	Type "Manage Enc Charges: Edit Access" in the "sec_role_comment" input
	Click the "Update Individual Security" button
Begin "Manage Employer Organizations Hierarchy"
	Open the sidemenu
	Click the "Employer Organizations" sidemenu entry
	Type "Better" in the name input
	Click the "Search" button
	Click the "Better Corp." link
	Click the "Overview (EO)" charttab
	Begin "Test Sub-Employer dynamic section"
		Verify exists "" text in "Sub-Employer Organizations" dynamicsection
		Begin "Add and Validate Sub-Employer Organization"
			Click the "Add New Sub-EO" link
			Type "Best Inc" in the name input
			Click the "Add New" button
			Verify exists "Attention" popup
			Verify exists "Enter required fields and/or address issues" text
			Verify exists "A unique MR number is required" text
			Close the Attention popup
			Type "9999" in the "mrnumber" input
			Verify exists Available text
			Click the "Add New" button
			@Wait for the Ajax to create the new chart@driver.wcutils.waitForAJAX(30)
			Verify exists "Best Inc" contactcard
		Begin "Validate New Sub-Employer Organization was added to Better Corp Overview(EO)"
			Open the sidemenu
			Click the "Employer Organizations" sidemenu entry
			Type "Better" in the name input
			Click the "Search" button
			Click the "Better Corp." link
			Click the "Overview (EO)" charttab
			Verify exists "Best Inc" text
Begin "Test Employer & Provider Organization Overview pages"
	Begin "Provider Organization"
		Begin "Manage Provider Organization dynamic section"
			Open the sidemenu
			Click the "Provider Management" sidemenu entry
			Type "PSC-Federal Occ" name input
			Click the "Search" button
			@wait@driver.waitFor(driver, lambda d: d.getElement(xpath="//a[contains(., 'PSC-Federal Occupational Health')]"), expected_return=True, timeout=5)
			Click the "PSC-Federal Occupational Health" link
			@wait@driver.waitFor(driver, lambda d: d.getElement(xpath="//*[contains(., 'Aaalastname')]"), expected_return=True, timeout=5)
			Begin "Validate Provider Organization section information and Postal Code logic"
				Begin "Validate the contact card information before changes"
					Verify exists "7700 Wisconsin Avenue" text
					Verify exists "Floor 7th" text
					Verify exists "Bethesda, Maryland 20814" text
					Verify exists "United States" text
				Begin "Edit Provider Information"
					Open the "Provider Organization" dynamicsection
					Type "20184" in the "DPI_zip_code" input
					Type "1234 Main Street" in the "DPI_address1" input
					Type "Suite 5" in the "DPI_address2" input
					Close the "Provider Organization" dynamicsection
				Begin "Validate the contact card information after changes from Postal Code logic changes"
					Verify exists "PSC-Federal Occupational Health" text
					Verify exists "FOH" text
					Verify exists "20184" text
					Verify exists "1234 Main Street" text
					Verify exists "Suite 5" text
					Verify exists "Upperville" text
					Verify exists "Virginia" text
					Verify exists "United States" text
		Begin "Manage Provider Organization Contacts dynamic section"
			Begin "Add a New test Contact and test other functionality"
				Click the "Add New Contact" link
				Type "Aaalastname" in the "last_name" input
				Begin "Test the alert for incomplete information"
					Click the "Add New" button
					Verify exists "Attention" popup
					Verify exists "Enter required fields and/or address issues" text
					Verify exists "Contact type is required" text
					Verify exists "First name is required" text
					Close popup
				Type "Aaalastname" in the "last_name" input
				Type "Firstname" in the "first_name" input
				Select "Agency Official Signatory Contact" from the "relation_type_desc" dropdown
				Type "faaalastname@foh.com" in the "email" input
				Enter "06-04-2099" into the "start_date" date
				Enter "06-04-2017" into the "end_date" date
				Click the "Add New" button
				Begin "Test the alert for incorrect date range"
					Verify exists "Attention" popup
					Verify exists "Enter required fields and/or address issues" text
					Verify exists "End date must be after start date" text
					Close popup
				Enter "03-23-2016" into the "start_date" date
				Enter "02-23-2022" into the "end_date" date
				Click the "Add New" button
				Begin "Test the New Contact Overview(Contact) page and verify New Contact, Firstname Aaalastname was added and the information is correct"
					Verify exists "Contact" dynamicsection
					Verify exists "Organizations" dynamicsection
					Open the "Organizations" dynamicsection
					Verify exists "Click on the organization below and edit the account" text
					Verify exists "Other Data" dynamicsection
					Verify exists "Chart Types" dynamicsection
					Verify exists "Firstname Aaalastname" contactcard
					Verify exists "faaalastname@foh.com" text in "Firstname Aaalastname" contactcard
					Verify exists "PSC-Federal Occupational Health" contactcard
					Verify exists "03-23-2016" text
					Verify exists "effective" text
					Verify exists "02-23-2022" text
					Verify exists "funding end date" text
					Verify exists "Contact" text
					Click the "Submit" button
				Begin "Verify New Contact, Firstname Aaalastname's contact card in PSC-Federal Occupational Health's Overview(PO)"
					Open the sidemenu
					Click the "Provider Management" sidemenu entry
					Type "PSC-Federal Occ" name input
					Click the "Search" button
					@wait@driver.waitFor(driver, lambda d: d.getElement(xpath="//a[contains(., 'PSC-Federal Occupational Health')]"), expected_return=True, timeout=5)
					Click the "PSC-Federal Occupational Health" link
					@wait@driver.waitFor(driver, lambda d: d.getElement(xpath="//*[contains(., 'Aaalastname')]"), expected_return=True, timeout=5)
					Verify exists "Aaalastname, Firstname" text
					Verify exists "Agency Official Signatory Contact" text
					Verify exists "03-23-2016" text
					Verify exists "02-23-2022" text
					Verify exists "faaalastname@foh.com" text
				Begin "Test Edit/End/Delete options in the editable Contacts section"
					Begin "Test the Edit button"
						Open the Contacts dynamicsection
						Click the 1st "Edit" button
						Enter "10-06-2011" into the "start_date" date
						Enter "10-06-2029" into the "end_date" date
						Click the "OK" button
						Begin "Verify that the contact was edited successfully"
							Verify exists "10-06-2011" text
							Verify exists "10-06-2029" text
					Begin "Test the End button"
						Click the 1st "End" button
						Verify exists "Unlink" text
						# Verify exists "le_pat_parent_relations_link_rel_pat_end_value0" checkbox
						Verify exists "Cancel" button
						# This line will fail, the checkbox is not working 12/1/17
						# Click the "le_pat_parent_relations_link_rel_pat_end_value0" checkbox
						Click the "Cancel" button
					Begin "Test the Delete button"
						Click the 1st "Delete" button
						Verify exists "Unlink" text
						# Verify exists "le_pat_parent_relations_link_rel_pat_end_value0" checkbox
						Verify exists "Cancel" button
						# This line will fail, the checkbox is not working 12/1/17
						# Click the "le_pat_parent_relations_link_rel_pat_end_value0" checkbox
						#Screenshot "Strikethrough Deleted Test Patient"
						# Change/remove the '2nd' from the following line when Sean enables detectVisible in Okra
						Close the Contacts dynamicsection
						# Uncomment this line when Sean adds functionality to not look for hidden content
						#Verify exists "Aaalastname, Firstname" text
						Open the Contacts dynamicsection
						# Uncomment this line when Sean adds functionality to not look for hidden content
						#Verify exists "Aaalastname, Firstname" text
			Begin "Add additional contacts for testing purposes"
				Begin "Add a New Contact - Sara Fallon"
					Navigate "?f=chart&s=pat&pat_id=10542"
					Click the "Overview (PO)" charttab
					Click the "Add New Contact" link
					Type "Fallon" in the "last_name" input
					Type "Sara" in the "first_name" input
					Select "Agency Official Signatory Contact" from the "relation_type_desc" dropdown
					Type "sfallon@foh.com" in the "email" input
					Enter "02-23-2016" into the "start_date" date
					Enter "02-23-2020" into the "end_date" date
					Click the "Add New" button
					Verify exists "Sara Fallon" contactcard
					Begin "Verify New Contact, Sara Fallon's contact card in PSC-Federal Occupational Health's Overview(PO)"
						Navigate "?f=chart&s=pat&pat_id=10542"
						Click the "Overview (PO)" charttab
						Verify exists "Fallon, Sara" text
						Verify exists "Agency Official Signatory Contact" text
						Verify exists "02-23-2016" text
						Verify exists "02-23-2020" text
						Verify exists "sfallon@foh.com" text
				Begin "Add a New Contact - Lucy Letterman"
					Navigate "?f=chart&s=pat&pat_id=10542"
					Click the "Overview (PO)" charttab
					Click the "Add New Contact" link
					Type "Letterman" in the "last_name" input
					Type "Lucy" in the "first_name" input
					Select "Agency Official Signatory Contact" from the "relation_type_desc" dropdown
					Type "lletterman@foh.com" in the "email" input
					Enter "02-23-2016" into the "start_date" date
					Enter "02-23-2020" into the "end_date" date
					Click the "Add New" button
					Verify exists "Lucy Letterman" contactcard
					Begin "Verify New Contact, Lucy Letterman's contact card in PSC-Federal Occupational Health's Overview(PO)"
						Navigate "?f=chart&s=pat&pat_id=10542"
						Click the "Overview (PO)" charttab
						Verify exists "Letterman, Lucy" text
						Verify exists "Agency Official Signatory Contact" text
						Verify exists "02-23-2016" text
						Verify exists "02-23-2020" text
						Verify exists "lletterman@foh.com" text
				Begin "Add a New Contact - David Kimmel"
					Navigate "?f=chart&s=pat&pat_id=10542"
					Click the "Overview (PO)" charttab
					Click the "Add New Contact" link
					Type "Kimmel" in the "last_name" input
					Type "David" in the "first_name" input
					Select "Agency Official Signatory Contact" from the "relation_type_desc" dropdown
					Type "dkimmel@foh.com" in the "email" input
					Enter "02-23-2016" into the "start_date" date
					Enter "02-23-2020" into the "end_date" date
					Click the "Add New" button
					Verify exists "David Kimmel" contactcard
					Begin "Verify New Contact, David Kimmel's contact card in PSC-Federal Occupational Health's Overview(PO)"
						Navigate "?f=chart&s=pat&pat_id=10542"
						Click the "Overview (PO)" charttab
						Verify exists "Kimmel, David" text
						Verify exists "Agency Official Signatory Contact" text
						Verify exists "02-23-2016" text
						Verify exists "02-23-2020" text
						Verify exists "dkimmel@foh.com" text
	Begin "Employer Organization"
		Begin "Manage Employer Organization dynamic section"
