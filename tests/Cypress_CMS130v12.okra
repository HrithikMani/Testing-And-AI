"""
 Cypress testing of Cypress CMS130v12 Measure
 @owners: dcarlson nrichardson
 filedeps: system/layouts/StructDoc/QRDA*.html, system/layouts/StructDocXSLTypes/QRDA.html, selenium/tests/Cypress_CMS*.okra, src/encounter_measures.c, system/reports/CMS130v12*.sql, system/reports/cql_*.sql, system/reports/CQL_*.sql, system/reports/quality_*.sql
"""

Begin "CMS130v12 Testing"

@driver.setTimeout(900)
@driver.miedb.dbExec("INSERT IGNORE INTO insurance_plans SET name='MEDICARE PLUS', active=1, insurance_type_code='1';")
@driver.miedb.dbExec("INSERT IGNORE INTO insurance_plans SET name='MEDICAID', active=1, insurance_type_code='2';")
@driver.miedb.dbExec("INSERT IGNORE INTO insurance_plans SET name='ABC Insurance', active=1, insurance_type_code='349';")

@driver.miedb.dbExec("INSERT IGNORE INTO patient_partitions(wc_partition,name,description) VALUES ('CMS130','CMS130','Partition for CMS130 patients');")
@driver.miedb.dbExec("INSERT IGNORE INTO document_types (doc_type, description, text_add, active, upload_add, allow_index) VALUES ('QRDA', 'QRDA Document', 1, 1, 1, 1);")
@driver.miedb.dbExec("UPDATE system_settings SET value = \"'MEANUSE','OFFICEF','HISTEXAM','PEDIATRICS','OFFENT','POV','VISIT','VIRTUAL'\", reason = 'Cypress testing' WHERE item='Meaningful Use Visit Types';")
@driver.miedb.dbExec("INSERT IGNORE INTO system_reports (name, category, description, notes, sql_query, create_date, revision_date, modified_by, run_counter, last_ran, restricted, active, realtime) VALUES ('Patient Chart Compare','','Patient Chart Compare','',\"SELECT\n  mrn1.wc_partition AS \'Partition A\',\n CONCAT(p1.last_name, \', \', p1.first_name, \'{$p}\', p1.pat_id) AS \'Name A\',\n    p1.birth_date AS \'Birthday A\',\n    p1.username AS \'Username A\',\n    p1.email AS \'Email A\',\n    mrn2.wc_partition AS \'Partition B\',\n    CONCAT(p2.last_name, \', \', p2.first_name, \'{$p}\', p2.pat_id) AS \'Name B\',\n    p2.birth_date AS \'Birthday B\',\n    p2.username AS \'Username B\',\n    p2.email AS \'Email B\',\n    dup.rating AS \'Similarity Rating\',\n    CONCAT(\'http://\', \'{$w|add_url=&webchart.cgi?opp=merge&f=chart&fix_dups=1&s=pat&t=Admin:Demographics&v=dashboard&merge_opts_\',p1.pat_id,\'=3&submit_merge=Merge+Using+Selected+Options&pat_id=\',p2.pat_id,\'&to_mrn=\',CONCAT(mrn2.wc_partition,\'-\', mrn2.mrnumber),\'&from_mrn=\',CONCAT(mrn1.wc_partition,\'-\', mrn1.mrnumber),\'&patient_pat_id=\',p1.pat_id,\'&from_pats_id=\',p1.pat_id,\'}\', \'Merge A to B\') AS \'Merge A to B\',\n    CONCAT(\'http://\', \'{$w|add_url=&webchart.cgi?opp=merge&f=chart&fix_dups=1&s=pat&t=Admin:Demographics&v=dashboard&merge_opts_\',p2.pat_id,\'=3&submit_merge=Merge+Using+Selected+Options&pat_id=\',p1.pat_id,\'&to_mrn=\',CONCAT(mrn1.wc_partition,\'-\', mrn1.mrnumber),\'&from_mrn=\',CONCAT(mrn2.wc_partition,\'-\', mrn2.mrnumber),\'&patient_pat_id=\',p2.pat_id,\'&from_pats_id=\',p2.pat_id,\'}\', \'Merge B to A\') AS \'Merge B to A\'\nFROM\n    patient_pdups dup\nINNER JOIN\n    patients p1 ON dup.pat_id = p1.pat_id\nINNER JOIN\n    patients p2 ON dup.pat_id_match = p2.pat_id\nINNER JOIN\npatient_mrns mrn1 ON p1.pat_id = mrn1.pat_id\nINNER JOIN\n       patient_mrns mrn2 ON p2.pat_id = mrn2.pat_id\nWHERE mrn1.wc_partition LIKE \'CMS%\'\nAND  mrn2.wc_partition LIKE \'CMS%\' AND dup.rating>3 ORDER BY mrn1.pat_id,mrn2.pat_id\",'2024-08-20 20:19:29','2024-08-20 20:19:29',97,0,'0000-00-00 00:00:00',0,1,0);")

