"""
	Test for File Upload Tests
	@owners: dcarlson
	@filedeps: system/layouts/StructDoc/*.html system/layouts/StructDocTypes/*.html
"""

# Ignore intentional error 'Unable to upload document'
@@@
driver.wcErrorLog.ignore("*Unable to upload document, because OIDs given are identified with more than one patient in our system*")
@@@

@Update system setting for Froozhie @driver.miedb.dbExec("UPDATE system_settings SET value='https://www.froozhie.com/froo.cgi?client=mie' WHERE (module,section,item)=('E-Chart','FroozHIE','URL Location')")

@@@Give MIE partition an OID for testing purposes
driver.miedb.dbExec("UPDATE patient_partitions SET wc_guid='1.2.840.114398.1.668.2' WHERE wc_partition='MIE';")
@@@

@@@Give David Butler and Emily Jones their MR partitions back for testing purposes
driver.miedb.dbExec("INSERT INTO patient_mrns SET wc_partition='MR', pat_id=14,mrnumber='10011';")
driver.miedb.dbExec("INSERT INTO patient_mrns SET wc_partition='MR', pat_id=10,mrnumber='10016';")
@@@

@@@Create new partition for testing purposes on not having access
driver.miedb.dbExec("INSERT INTO patient_partitions SET wc_guid='1.2.840.114398.1.668.3',wc_partition='MIE2',name='MIE2',description='No Access',mr_sequence=10000,echart_opts='A',active=1,restricted=1;")
driver.miedb.dbExec("INSERT INTO patient_partitions_restricted SET wc_partition='MIE2',allowed_id='Scheduling Resources',id_type='realm';")
@@@

@@@Insert a dummy document to make sure the auto_increment is set correctly
driver.miedb.dbExec("INSERT INTO documents SET pat_id=3, storage_type=0;")
@@@

Begin "Check upload by pat_id, exists"
	@@@Get expected next doc_id
	res = driver.miedb.dbQuery("SELECT max(doc_id) AS doc_id FROM documents")
	if res:
		res = res.getRes()
		driver.setUserData('doc_id', res[0]['doc_id']+1)
	@@@
	Navigate "?f=chart&s=upload&storage_type=19&register_patient=1&doc_type=WCDOCNOT&service_date=2021-01-28+09%3A48%3A25&show_xheaders=0&subject_txt=Test Document&pat_id=18&file=%3CClinicalDocument%20xmlns%3Axsi%3D%22http%3A%2F%2Fwww.w3.org%2F2001%2FXMLSchema-instance%22%20xmlns%3D%22urn%3Ahl7-org%3Av3%22%20xmlns%3Acda%3D%22urn%3Ahl7-org%3Av3%22%20xmlns%3Asdtc%3D%22urn%3Ahl7-org%3Asdtc%22%20classCode%3D%22DOCCLIN%22%20moodCode%3D%22EVN%22%3E%3CrecordTarget%3E%3CpatientRole%3E%3Cid+extension%3D%2210019%22+root%3D%221.2.840.114398.1.668.5%22%3E%3C%2Fid%3E%3Cpatient%3E%3Cname+use%3D%22L%22%3E%3Cgiven%3EWilliam%3C%2Fgiven%3E%3Cgiven%3ES.%3C%2Fgiven%3E%3Cfamily%3ETester%3C%2Ffamily%3E%3C%2Fname%3E%3C%2Fpatient%3E%3CadministrativeGenderCode+code%3D%22M%22+codeSystem%3D%222.16.840.1.113883.5.1%22+displayName%3D%22Male%22%3E%3C%2FadministrativeGenderCode%3E%3CbirthTime+value%3D%2219541130%22%3E%3C%2FbirthTime%3E%3C%2FpatientRole%3E%3C%2FrecordTarget%3E%3C%2FClinicalDocument%3E"
	@@@Validate that the document went to chart pat_id=18
	res = driver.miedb.dbQuery("SELECT d.pat_id AS pat_id FROM documents d WHERE doc_id="+str(driver.getUserData('doc_id')))
	if res:
		res = res.getRes()
		driver.reportCommandStatus('Verify that pat_id is 18',
			'Pat_id: {0}'.format(res[0]['pat_id']), res[0]['pat_id'] == 18, '', '')
	@@@
Begin "Check upload by pat_id, not exists, reject document"
	@@@Get expected next doc_id and pat_id
	res = driver.miedb.dbQuery("SELECT max(doc_id) AS doc_id FROM documents")
	if res:
		res = res.getRes()
		driver.setUserData('doc_id', res[0]['doc_id']+1)
	res = driver.miedb.dbQuery("SELECT max(pat_id) AS pat_id FROM patients")
	if res:
		res = res.getRes()
		driver.setUserData('pat_id', res[0]['pat_id']+1)
	@@@
	Navigate "?f=chart&s=upload&storage_type=19&register_patient=1&doc_type=WCDOCNOT&service_date=2021-01-28+09%3A48%3A25&show_xheaders=0&subject_txt=Test Document&pat_id=1000000018&file=%3CClinicalDocument%20xmlns%3Axsi%3D%22http%3A%2F%2Fwww.w3.org%2F2001%2FXMLSchema-instance%22%20xmlns%3D%22urn%3Ahl7-org%3Av3%22%20xmlns%3Acda%3D%22urn%3Ahl7-org%3Av3%22%20xmlns%3Asdtc%3D%22urn%3Ahl7-org%3Asdtc%22%20classCode%3D%22DOCCLIN%22%20moodCode%3D%22EVN%22%3E%3CrecordTarget%3E%3CpatientRole%3E%3Cid+extension%3D%2210019%22+root%3D%221.2.840.114398.1.668.5%22%3E%3C%2Fid%3E%3Cpatient%3E%3Cname+use%3D%22L%22%3E%3Cgiven%3EWilliam%3C%2Fgiven%3E%3Cgiven%3ES.%3C%2Fgiven%3E%3Cfamily%3ETester%3C%2Ffamily%3E%3C%2Fname%3E%3C%2Fpatient%3E%3CadministrativeGenderCode+code%3D%22M%22+codeSystem%3D%222.16.840.1.113883.5.1%22+displayName%3D%22Male%22%3E%3C%2FadministrativeGenderCode%3E%3CbirthTime+value%3D%2219541130%22%3E%3C%2FbirthTime%3E%3C%2FpatientRole%3E%3C%2FrecordTarget%3E%3C%2FClinicalDocument%3E"
	@@@Validate that we rejected the document and didn't create a new document
	res = driver.miedb.dbQuery("SELECT count(*) AS docs FROM documents d WHERE doc_id="+str(driver.getUserData('doc_id')))
	if res:
		res = res.getRes()
		driver.reportCommandStatus('Verify that number of documents rows as doc_id = '+ str(driver.getUserData('doc_id')) +' is 0',
			'Rows: {0}'.format(res[0]['docs']), res[0]['docs'] == 0, '', '')
	@@@

	@@@Validate that we rejected the document and didn't create a new patient
	res = driver.miedb.dbQuery("SELECT count(*) AS p FROM patients p WHERE pat_id="+str(driver.getUserData('pat_id')))
	if res:
		res = res.getRes()
		driver.reportCommandStatus('Verify that number of patient rows as pat_id = '+ str(driver.getUserData('pat_id')) +' is 0',
			'Rows: {0}'.format(res[0]['p']), res[0]['p'] == 0, '', '')
	@@@
