Begin "Logout and Log Back In As dave/dave, who doesn't have rights to certain charts
	Begin "Enable New Login Style"
		@@@Enable New Login Style
		driver.miedb.dbExec("UPDATE system_settings SET value='1' WHERE module='System' AND section='Login' AND item='New login style'")
		@@@
	Navigate "?f=logout"
	Click the "Standard Login" button
	Type 'dave' into the 'login_user' input
	Type 'dave' into the 'login_passwd' input
	Click the "Next" button
	Verify exists "Latest news" text

@@@Set Dave account's security_role_id to be 'Restrict Access By Partition'=yes, for test uploading a new patient to a restricted chart it doesn't have access to
driver.miedb.dbExec("UPDATE security_role_acl SET security_value=1 WHERE security_role_id=12 and category_name='Restrict Access By Partition';")
@@@

