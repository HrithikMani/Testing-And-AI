	Navigate "?f=chart&s=upload&storage_type=19&register_patient=1&doc_type=WCDOCNOT&service_date=2021-01-28+09%3A48%3A25&show_xheaders=0&subject_txt=Test Document&mrOID=1.2.840.114398.1.668.1-999916&mrOID=1.2.840.114398.1.668.2-99928&file=%3CClinicalDocument%20xmlns%3Axsi%3D%22http%3A%2F%2Fwww.w3.org%2F2001%2FXMLSchema-instance%22%20xmlns%3D%22urn%3Ahl7-org%3Av3%22%20xmlns%3Acda%3D%22urn%3Ahl7-org%3Av3%22%20xmlns%3Asdtc%3D%22urn%3Ahl7-org%3Asdtc%22%20classCode%3D%22DOCCLIN%22%20moodCode%3D%22EVN%22%3E%3CrecordTarget%3E%3CpatientRole%3E%3Cid+extension%3D%2210019%22+root%3D%221.2.840.114398.1.668.5%22%3E%3C%2Fid%3E%3Cpatient%3E%3Cname+use%3D%22L%22%3E%3Cgiven%3EWilliam%3C%2Fgiven%3E%3Cgiven%3ES.%3C%2Fgiven%3E%3Cfamily%3ETester%3C%2Ffamily%3E%3C%2Fname%3E%3C%2Fpatient%3E%3CadministrativeGenderCode+code%3D%22M%22+codeSystem%3D%222.16.840.1.113883.5.1%22+displayName%3D%22Male%22%3E%3C%2FadministrativeGenderCode%3E%3CbirthTime+value%3D%2219541130%22%3E%3C%2FbirthTime%3E%3C%2FpatientRole%3E%3C%2FrecordTarget%3E%3C%2FClinicalDocument%3E"
	@@@Validate that the document went to the next pat_id (newly created patient)
	res = driver.miedb.dbQuery("SELECT d.pat_id AS pat_id FROM documents d WHERE doc_id="+str(driver.getUserData('doc_id')))
	if res:
		res = res.getRes()
		driver.reportCommandStatus('Verify that pat_id is ' + str(driver.getUserData('pat_id')),
			'Pat_id: {0}'.format(res[0]['pat_id']), res[0]['pat_id'] == driver.getUserData('pat_id'), '', '')
	@@@	
