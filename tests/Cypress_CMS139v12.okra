@@@
# Generate QRDA Is and zip for upload
import requests
import zipfile
import os

res = driver.miedb.dbQuery('SELECT session_id FROM logins ORDER BY id DESC LIMIT 1')
session_id = res.getRow(0)['session_id']
patres = driver.miedb.dbQuery(
				"SET @performing_user_id=(SELECT user_id FROM users WHERE username='selenium');SET @begin_date='2024-01-01';SET @end_date='2024-12-31';SELECT p.pat_id "
				"FROM rxdb_utf8_test.Measures mm "
				"INNER JOIN measure_calc mc ON mm.report_name=mc.report_name "
				"INNER JOIN encounters e ON mc.encounter_id=e.encounter_id "
				"INNER JOIN patients p ON e.pat_id=p.pat_id "
				"INNER JOIN patient_mrns pm ON p.pat_id=pm.pat_id "
				"WHERE mm.eMeasureId='CMS139v12' "
				"AND p.is_tmp = 0 "
				"AND mc.init_pat_pop>0 "
				"AND pm.wc_partition IN ('CMS139') "
				"AND e.serv_date BETWEEN CONCAT( @begin_date, ' 00:00:00') AND CONCAT(@end_date, ' 23:59:59') "
				"AND e.performing_user_id = @performing_user_id "
				"GROUP BY e.pat_id")

def create_zip_file(file_names, zip_name, driver):
	with zipfile.ZipFile(zip_name, 'w') as zipf:
		for file in file_names:
			driver.getWebDriver()
			if os.path.isfile(file):
				zipf.write(file, os.path.basename(file))

files_to_zip = []

for patRow in patres: 
	pat_id = patRow['pat_id']
	url = (
	f"{driver.driverOptions.baseurl}?f=layout&session_id={session_id}&module=StructDocTypes&name=QRDA-I&cdatype=QRDA"
	f"&pat_id={pat_id}&begin_dateYEAR=2024&begin_dateMONTH=1&begin_dateDAY=1&begin_date=2024-01-01"
	f"&end_dateYEAR=2024&end_dateMONTH=12&end_dateDAY=31&end_date=2024-12-31"
	f"&output_filename=QRDA{pat_id}.xml&qrda_consumer=Cypress&debug_level=0&measure_id=CMS139v12&XML"
	)
	file_path = f"{driver.driverOptions.uploadDir}/QRDA{pat_id}.xml"
	r = requests.get(url, allow_redirects=True)
	open(file_path, 'wb').write(r.content)
	files_to_zip.append(file_path)
	driver.getWebDriver().execute_script("return 1")

zip_file_name = f"{driver.driverOptions.uploadDir}/WebChartDownloadCMS139v12.zip"
create_zip_file(files_to_zip, zip_file_name, driver)

driver.miedb.dbExec("UPDATE users SET nat_pro_id='1303691434', tax_id_number='327273814' WHERE user_id=8;")

url = (
f"{driver.driverOptions.baseurl}?f=layout&session_id={session_id}&XML&module=StructDocTypes&name=QRDA-III&year=2024"
f"&begin_dateMONTH=01&begin_dateDAY=01&begin_dateYEAR=2024&end_dateMONTH=12&end_dateDAY=31&end_dateYEAR=2024"
f"&my_user_id=8&partition=CMS139&measure_id=CMS139v12"
)
file_path = f"{driver.driverOptions.uploadDir}/QRDAIII.xml"
r = requests.get(url, allow_redirects=True)
open(file_path, 'wb').write(r.content)

@@@

# Upload QRDA I zip
@driver.getWebDriver().get("http://cypress730.med-web.com/users/sign_out")
Type "rxdb@med-web.com" into the "user_email" input
Type "Cypress2024" into the "user_password" input
Click the "Sign in" button
Click the "Selenium Testing" link
CLick the "Selenium 2024" link
Click the "C1 (QRDA-I)" link
Click the 1st "Falls: Screening for Future Fall Risk" link
@Wait for the file results element to appear@driver.waitFor(driver, lambda d: d.getElement(xpath='//file[@id="results"] '), expected_return=True, timeout=60)

@driver.runJS("document.getElementById('results').style.display='block';")
@driver.runJS("document.getElementById('results').classList.remove('hidden');")
@driver.runJS("document.getElementById('results').setAttribute('aria-hidden', 'false');")
@driver.runJS("document.getElementById('results').parentNode.parentNode.appendChild(document.getElementById('results'));")

Type "WebChartDownloadCMS139v12.zip" into the "results" input
@driver.runJS("document.getElementById('submit-upload').classList.remove('fileinput-exists');")
Click on the " Upload" link

@Wait for the exposed objects to go away on refresh@driver.waitFor(driver, lambda d: d.getElement(xpath='//*[@id="results" and not(contains(@style, "display: block"))]'), expected_return=False, timeout=60)

@Wait for the test to pass@driver.waitFor(driver, lambda d: d.getElement(xpath='//p[@class="lead bg-success execution-status"] '), expected_return=True, timeout=600)
Screenshot "QRDA I Results" 
Verify exists "Passed" text

