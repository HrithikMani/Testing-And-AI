Begin "Add Inez Garza to Animal Exposure Panel"
	Navigate "?f=chart&s=pat&t=Admin%3APanel+Membership+Overview&v=dashboard&pat_id=47"
	Wait for page
	Select "Animal Exposure (Allergy)" from the dropdown
	Click the Submit button
	Wait for page
	Close the popup
	Click the HSPPM_E_ANIMALHAND_47_check checkbox
	Click the Submit button
	Wait for page

Begin "Complete orders"
	Navigate "?f=chart&s=pat&t=Admin%3ADue+List&v=dashboard&pat_id=47"
	Wait for the EncounterOrdersGridDV grid
	Click the @xpath="(//div[@id='EncounterOrdersGridDV']//input[@name='checkAll'])[1]"
# Ticket 120461 grid buttons
#	Click the "Edit" grid button
	Click @the "Edit" grid button@xpath='//div[@class="wcdv_grid"]//div[not(contains(@id, "tt"))]//button[@type="button" and not(@disabled)]/span[contains(., "Edit")]'
	Select "Completed" from the Status popup dropdown
	Enter "06-01-2010" in the 2nd "completed_dt" date
	Click the Save popup button
	Wait for page

Begin "Set due date"
	Navigate "?f=chart&s=pat&t=Admin%3APanel+Membership+Overview&v=dashboard&pat_id=47"
	Wait for page
	Click the 1st "Set Due Date" button
	Enter "03-01-2009" in the "panel_status_next_due" date
	Click the Submit popup button
	Wait for page

Begin "Time Travel ahead 2 years and evaluate"
	Navigate "?tabmodule=admin&tabselect=Health+Surveillance&f=panelactiontest&s=time_machine"
	Wait for page
	Enter "02-02-2009" in the date
	Click the "Submit" button
	Enter "Garza, Inez" in the "pat_id" autocomplete
	Click the "Evaluate" button

Begin "Time Travel ahead 1 day and evaluate"
	Navigate "?tabmodule=admin&tabselect=Health+Surveillance&f=panelactiontest&s=time_machine"
	Wait for page
	Enter "02-03-2009" in the date
	Click the "Submit" button
	Enter "Garza, Inez" in the "pat_id" autocomplete
	Click the "Evaluate" button
	Verify notexists "PERFORM-event visible: 01-15-2009" text
