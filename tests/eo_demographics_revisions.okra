Begin Test Employer Organization Demographics Revisions
	Navigate "?f=chart&s=pat&pat_id=43"
	Open the "Employer Organization" dynamicsection	
	Close the "Employer Organization" dynamicsection
	Open the "Employer Organization" dynamicsection
	Verify exists @0 in Revision # column@xpath="//tr[1]/td[1][text()='0']"
	Verify exists @Engineering, Medical Informatics in Revised By column@xpath="//tr[1]/td[2][text()='Engineering, Medical Informatics']"
	Verify exists @04-24-2023 13:30 in Revision Date column@xpath="//tr[1]/td[3][text()='04-24-2023 13:30']"
	Verify exists @Better Corp. in Name column@xpath="//tr[1]/td[4][text()='Better Corp.']"
	Verify exists @US in Country column@xpath="//tr[1]/td[6][text()='US']"
	Verify exists @94043 in Postal Code column@xpath="//tr[1]/td[7][text()='94043']"
	Verify exists @12001 Pacific Coast Highway in Address 1 column@xpath="//tr[1]/td[8][text()='12001 Pacific Coast Highway']"
	Verify !exists @text in Address 2 column@xpath="//tr[1]/td[9]/text()"
	Verify exists @Santa Clara in County column@xpath="//tr[1]/td[10][text()='Santa Clara']"
	Verify exists @Mountain View in City column@xpath="//tr[1]/td[11][text()='Mountain View']"
	Verify exists @CA in State/Province column@xpath="//tr[1]/td[12][text()='CA']"
	Verify exists @(650) 459-6270 in Work Phone column@xpath="//tr[1]/td[13][text()='(650) 459-6270']"
	Verify exists @(650) 459-6271 in Fax Number column@xpath="//tr[1]/td[14][text()='(650) 459-6271']"
	Verify !exists @text in Date Deactivated column@xpath="//tr[1]/td[15]/text()"
	Close the "Employer Organization" dynamicsection
