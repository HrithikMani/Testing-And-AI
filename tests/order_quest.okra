@Give David Carter a static MR number@driver.miedb.dbExec("INSERT INTO patient_mrns SET wc_partition='MR',pat_id=14,mrnumber='91754'")
@Create Quest Picklist@driver.miedb.dbExec("INSERT INTO order_pick_list SET set_name='Quest Labs', group_by='Group A', order_id=388, order_by=1, column_index='1'")
@Create Refer To Systems Entry Quest@driver.miedb.dbExec("INSERT INTO refer_to_systems SET system_id='QUESTLABS', system_name='Quest Labs', system_options=68")
@Create Refer To Systems Entry "Quest Test"@driver.miedb.dbExec("INSERT INTO refer_to_systems SET system_id='QUESTLABSTEST', system_name='Quest Test', system_options=68")

@Create Refer To Systems Extended Entries Quest@driver.miedb.dbExec("INSERT INTO refer_to_systems_extended_values SET system_id='QUESTLABS', ext_id=(SELECT ext_id FROM refer_to_systems_extended_index WHERE name='gt1_rel_type_ids'),value='1'")
@Create Refer To Systems Extended Entries Quest test@driver.miedb.dbExec("INSERT INTO refer_to_systems_extended_values SET system_id='QUESTLABSTEST', ext_id=(SELECT ext_id FROM refer_to_systems_extended_index WHERE name='gt1_rel_type_ids'),value='1'")

@Add Translation 1@driver.miedb.dbExec("INSERT INTO translate SET name = 'quest-sending_facilities',  trans_from = 'OFFICE', trans_to = 'ABC123'")
@Add Translation 2@driver.miedb.dbExec("INSERT INTO translate SET name='quest-account_numbers', trans_from='*:Office', trans_to='123456789'")
@Add Translation 3@driver.miedb.dbExec("INSERT INTO translate SET name = 'QUESTLABSTEST-sending_facilities', trans_from = 'OFFICE', trans_to = 'DEF123'")
@Add Translation 4@driver.miedb.dbExec("INSERT INTO translate SET name = 'QUESTLABSTEST-account_numbers', trans_from = 'MR:Office', trans_to = '987654321'")


Open the sidemenu
Click the "E-Chart" link
Type "Carter" in the "sstring" input
Click the "Search" button

Click the "Add Order" link
Begin "Order Request"
	Select "Selenium, Selenium" from the "ordering_physician" dropdown
	Select "Soon" from the "schedule_comment" dropdown
	Select "Office" from the "location" dropdown
	Type "Order comments." in the "comments" input
	Select "Quest Labs" from the "performing_facility" dropdown
	Select "Quest Labs" from the "set_name" dropdown
	Click the "BUN" picklist checkbox
	@Select MR-91754 from the MR number dropdown@driver.enterFormData("MR-91754", id="mrnumber", blur=False)
	Click the "Submit" button
@Switch Windows@driver.switchToPopup()
Verify exists "Quest Diagnostics" text
Verify exists "123456789" text
@Close this window@driver.closePopup()


Click the "Medical Record" charttab
Click the "OrderRequestsLegacy" charttab subtab

Select "All" from the "location" dropdown
Select "Quest Labs" from the "set_name" dropdown
Click the "Search" button
Click the "Edit" link

Begin "Order Request"
	Select "Quest Test" from the "performing_facility" dropdown
	@Select MR-91754 from the MR number dropdown@driver.enterFormData("MR-91754", id="mrnumber", blur=False)
	Click the "Submit" button
@Switch Windows@driver.switchToPopup()
Verify exists "Quest Diagnostics" text
Verify exists "987654321" text
@Close this window@driver.closePopup()

@Remove David Carter's static MR number@driver.miedb.dbExec("DELETE FROM patient_mrns WHERE wc_partition='MR' AND pat_id=14 AND mrnumber='91754'")

