		@@@Verify that the Ishihara order only created 1 document
		driver.wcutils.waitForAJAX(30)
		res = driver.miedb.dbQuery("SELECT COUNT(*) AS c FROM documents WHERE pat_id=40 AND doc_type='ISHIHARA' AND DATE(service_date) = '2007-02-02'")
		if res:
			res = res.getRes()
			driver.reportCommandStatus('Verify that exactly one Ishihara document got made',
				'Doc Count: {0}'.format(res[0]['c']), res[0]['c'] == 1, '', '')
		@@@
