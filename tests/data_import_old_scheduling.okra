Begin "Import file"
	Open the sidemenu
	Click "Control Panel" sidemenu entry
	Click the Interface charttab
	Click the "Data import" charttab subtab
	Click the "Legacy Data Import" link
	Verify exists "Please Choose Data Import type:" text 
	Select "Appointments CSV API" in the opp dropdown
	Click the Go button
	@driver.getWebDriver().switch_to.frame("di_frame_Scheduling")
	Type "data_import_old_scheduling.okra" in the Interface input
	Click the "DI_Verbose" checkbox
	Type 'AppointmentCSVTest.csv' in the 'csv_file' input
	Click the "Upload" button
	Verify exists "Successfully imported file AppointmentCSVTest.csv!" text
	@driver.getWebDriver().switch_to.parent_frame()