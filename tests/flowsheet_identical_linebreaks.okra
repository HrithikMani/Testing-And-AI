Begin "Setup Observations"
	Open the sidemenu
	Click the "Control Panel" sidemenu entry
	Click the "Chart" charttab
	Click the "Observation Codes" charttab subtab

	Click the "Add Observation Code" link
	Type "FlowsheetTestIdentLine_Alpha" in the "obs_name" input
	Click the "Save" button
	Verify exists "!Successfully added new observation code." text

	Click the "Add Observation Code" link
	Type "FlowsheetTestIdentLine_Bravo" in the "obs_name" input
	Click the "Save" button
	Verify exists "!Successfully added new observation code." text

	Click the "Add Observation Code" link
	Type "FlowsheetTestIdentLine_Firebreak" in the "obs_name" input
	Click the "Save" button
	Verify exists "!Successfully added new observation code." text

	Type "FlowsheetTestIdentLine" into the "select_text" input
	Click the "Go" button
	Verify exists "Displaying 1-3 / 3" text

Begin "Setup Flowsheet"
	Open the sidemenu
	Click the "Control Panel" sidemenu entry
	Click the "Chart" charttab
	Click the "Observation Codes" charttab subtab
	Click the "Display Flowsheets" link
	Click the "Add Flowsheet" link
	Type "FlowsheetTestIdentLine" in the "form_name" input

	Click the "Add Line Break / Header" button
	Click the 1st "Edit" icon
	Verify exists "!Edit Line Break / Header" popup
	Type "This Text Always Shows" into the "Description" input
	Click the "Save" popup button

	Enter "FlowsheetTestIdentLine_Alpha" in the "obs_name" autocomplete
	Select "Yes/No Answer List" from the 1st dropdown

	Click the "Add Line Break / Header" button
	Click the 3rd "Edit" icon
	Verify exists "!Edit Line Break / Header" popup
	Type "This Text is Conditional and Identical" into the "Description" input
	Type "observationDisplay('FlowsheetTestIdentLine_Alpha', 'Yes')" into the "Conditional" input
	Click the "Save" popup button

	Click the "Add Line Break / Header" button
	Click the 4th "Edit" icon
	Verify exists "!Edit Line Break / Header" popup
	Type "This Text is Conditional on Alpha = Yes" into the "Description" input
	Type "observationDisplay('FlowsheetTestIdentLine_Alpha', 'Yes')" into the "Conditional" input
	Click the "Save" popup button

	Click the "Add Line Break / Header" button
	Click the 5th "Edit" icon
	Verify exists "!Edit Line Break / Header" popup
	Type "This Text Always Shows" into the "Description" input
	Click the "Save" popup button

	Enter "FlowsheetTestIdentLine_Bravo" in the "obs_name" autocomplete
	Select "Yes/No Answer List" from the 3rd dropdown

	Click the "Add Line Break / Header" button
	Click the 7th "Edit" icon
	Verify exists "!Edit Line Break / Header" popup
	Type "This Text is Conditional and Identical" into the "Description" input
	Type "observationDisplay('FlowsheetTestIdentLine_Bravo', 'Yes')" into the "Conditional" input
	Click the "Save" popup button

	Click the "Add Line Break / Header" button
	Click the 8th "Edit" icon
	Verify exists "!Edit Line Break / Header" popup
	Type "This Text is Conditional on Bravo = Yes" into the "Description" input
	Type "observationDisplay('FlowsheetTestIdentLine_Bravo', 'Yes')" into the "Conditional" input
	Click the "Save" popup button

	# We're not actually going to use this, I just don't want to deal with the
	# section closing automatically after I type into the last input.

	Enter "FlowsheetTestIdentLine_Firebreak" in the "obs_name" autocomplete
	Select "Text" from the 5th dropdown

	Click the "Submit" button

	Type "FlowsheetTestIdentLine" into the "select_text" input
	Click the "Go" button
	Verify exists "Displaying 1-1 / 1" text

Begin "Setup Order"
	Open the sidemenu
	Click the "Control Panel" sidemenu entry
	Click the "Orders" charttab
	Click the "Orders-List Editor" charttab subtab
	# Click the "Old Order Lists Editor" link
	
	Click the "Add Order" button
	Select "Exams (EXAM)" from the "Order Type" dropdown
	Type "FlowsheetTestIdentLine" in the "Order Name" input
	Select "Flowsheet" from the "Exam Order Layouts" dropdown
	Click the "Save" button
	
	Navigate ?f=layout&module=Orders&name=OrderList&tabmodule=admin&tabselect=Orders&ts_caption=Orders-List+Editor	
	Wait for the "orderlist" grid
	Click the @Code filter button@xpath="//div[contains(@class, 'outer thead')]//div[contains(@class, 'wcdv_heading_container')]/span[@data-wcdv-field='Name']/following-sibling::div/button[contains(@class, 'wcdv_icon_button')]"
	Click the @filter search input@xpath="//li[@data-wcdv-field='Name']//p[contains(@class, 'SelectBox')]"
	Type "FlowsheetTestIdentLine" in @xpath="//input[@class='search-txt' and @placeholder='Search...']"
	Click the "FlowsheetTestIdentLine" label
	Click the @ok button@xpath="//li[@data-wcdv-field='Name']//p[@class='btnOk']"
	Verify exists "FlowsheetTestIdentLine" grid entry

	# Click the "Add An Order" link
	# Select "Exams (EXAM)" from the "orl_type" dropdown
	# Type "FlowsheetTestIdentLine" into the "orl_name" input
	# Select "Flowsheet" from the "orl_layout_name" dropdown
	# Click the "Save" button

	# Verify exists "!Order List Entry Added" text
	# Type "FlowsheetTestIdentLine" into the "srch_text" input
	# Click the "Search" button
	# Verify exists "Displaying 1-1 / 1" text

Begin "Find patient, add encounter"
	Open the sidemenu
	Click the "E-Chart" sidemenu entry
	Type "Harris, Christine" into the sstring input
	Click the Search button
	Open the quicklink list
	Click the "Add Visit" quicklink
	@Wait for the dynamic encounter section to open@driver.wcutils.waitForAJAX(30)
	# No growl notifications please.
	@wait for growl@driver.waitFor(driver, lambda d: d.getElement(xpath='//div[@class="growl-message"]'), expected_return=False, timeout=60)

Begin "Add order for FlowsheetTestIdentLine"
	# Within the Smart Plan, the Visit Orders quicklist starts off hidden (i.e. collapsed).  For
	# some reason, this doesn't support the colon syntax like [quicklist item] does, so just hope
	# that there's only one Visit Orders quicklist.
	Show "Smart Plan" "Visit Orders" quicklist
	Add "Smart Plan:Visit Orders" "Other" quicklist item
	Enter "FlowsheetTestIdentLine" in the "order_id" autocomplete
	# We've got two save buttons: 1st = "Save to Library", 2nd = "Save"
	Click the 2nd "Save" popup button
	Examadd "Smart Plan" "FlowsheetTestIdentLin" dynamicitem

Begin "Test 1"
	Open the "FlowsheetTestIdentLine" dynamicsection

	# Thought this might help me see more stuff in the failure screenshot, but
	# the last touched input is still at the very bottom of the screen, and the
	# things that get shown/hidden conditionally are below the input. So this
	# doesn't do anything. I thought it would show the bottom of the section.

	@Scroll full section into view@driver.runJS("document.evaluate(`//div[contains(@class, 'edit-buttons')]/button[contains(@class, 'next')]`, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.scrollIntoView();")

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify notexists 1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Click 1st "FlowsheetTestIdentLine_Alpha" flowsheet radio

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify exists    1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Close the "FlowsheetTestIdentLine" dynamicsection

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify exists    1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Open the "FlowsheetTestIdentLine" dynamicsection

	Click 1st "FlowsheetTestIdentLine_Bravo" flowsheet radio

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify exists    1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify exists    2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Close the "FlowsheetTestIdentLine" dynamicsection

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify exists    1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify exists    2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Open the "FlowsheetTestIdentLine" dynamicsection

	Click 2nd "FlowsheetTestIdentLine_Alpha" flowsheet radio

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify exists    1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Close the "FlowsheetTestIdentLine" dynamicsection

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify exists    1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify exists        "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Open the "FlowsheetTestIdentLine" dynamicsection

	Click 2nd "FlowsheetTestIdentLine_Bravo" flowsheet radio

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify notexists 1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Bravo = Yes" flowsheet section_header

	Close the "FlowsheetTestIdentLine" dynamicsection

	Verify exists    1st "This Text Always Shows"                  flowsheet section_header
	Verify notexists 1st "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Alpha = Yes" flowsheet section_header
	Verify exists    2nd "This Text Always Shows"                  flowsheet section_header
	Verify notexists 2nd "This Text is Conditional and Identical"  flowsheet section_header
	Verify notexists     "This Text is Conditional on Bravo = Yes" flowsheet section_header
