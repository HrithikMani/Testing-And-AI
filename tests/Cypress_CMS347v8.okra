@driver.miedb.dbExec("DELETE FROM `system_reports` WHERE name='Patient Chart Compare';")
@driver.miedb.dbExec("DELETE FROM `patient_mrns` WHERE wc_partition LIKE 'CMS%';")
@driver.miedb.dbExec("DELETE FROM `patient_partitions` WHERE wc_partition LIKE 'CMS%';")