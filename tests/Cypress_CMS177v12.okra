@driver.runJS("document.getElementById('results').style.display='block';")
@driver.runJS("document.getElementById('results').classList.remove('hidden');")
@driver.runJS("document.getElementById('results').setAttribute('aria-hidden', 'false');")
@driver.runJS("document.getElementById('results').parentNode.parentNode.appendChild(document.getElementById('results'));")

Type "WebChartDownloadCMS177v12.zip" into the "results" input
@driver.runJS("document.getElementById('submit-upload').classList.remove('fileinput-exists');")
Click on the " Upload" link

