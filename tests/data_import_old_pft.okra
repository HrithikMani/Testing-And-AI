Begin "Import file"
	Open the sidemenu
	Click "Control Panel" sidemenu entry
	Click the Interface charttab
	Click the "Data import" charttab subtab
	Click the "Legacy Data Import" link
	Verify exists "Please Choose Data Import type:" text 
	Select "PFT Data CSV API" in the opp dropdown
	Click the Go button
	@driver.getWebDriver().switch_to.frame("di_frame_PFT_2FSpirometry")
	Click the "DI_Verbose" checkbox
	Select "|" from the "Delimiter" dropdown
	Type 'PftDataImportSuccess.csv' in the 'csv_file' input
	Click the "Upload" button
	Verify exists "Successfully imported file PftDataImportSuccess.csv!" text
	@driver.getWebDriver().switch_to.parent_frame()
Begin "Verify Entries"
	Open the sidemenu
	Click "E-Chart" sidemenu entry
	Click the "Name" radio
	Type "Doe" in the "sstring" input
	Click the "Search" button
	Verify exists "TEST-10006" link
	Click the "TEST-10006" link
	Click the "Medical Record" charttab
	Click the PFT charttab subtab
	Verify exists "Displaying 1-2" text
	@driver.wcutils.waitForAJAX(quiet=2)
	Verify exists "01-01-2014" listview link
	Click the "01-01-2014" listview link
	Verify exists "PFT Results" text
	Click the "Medical Record" charttab
	Click the PFT charttab subtab
	Verify exists "Displaying 1-2" text
	@driver.wcutils.waitForAJAX(quiet=2)
	Verify exists "01-02-2014" listview link
	Click the "01-02-2014" listview link
	Verify exists "PFT Results" text