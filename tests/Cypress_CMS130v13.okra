while len(driver.getElements(xpath="(//a[string(.)='Merge B to A'])")) > 1:
	driver.clickElement(xpath="(//a[string(.)='Merge B to A'])[2]")
	driver.pause(2)
	driver.navigate("?f=admin&s=system_report&opp=query&report_name=Patient%20Chart%20Compare&submit_query")
