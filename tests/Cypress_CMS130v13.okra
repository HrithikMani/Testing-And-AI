@driver.miedb.dbExec("INSERT INTO measure_enrollment (report_name,provider_id,start_date,end_date,status,reporting_program,use_case) select report_name,8,'2025-01-01','2025-12-31',1,'MIPS','report' from rxdb_utf8.Measures where eMeasureId like 'CMS130v13' order by eMeasureId;")

Navigate "?f=layout&module=MIPS&name=Quality+of+Care+Status&tabmodule=reports&tabselect=Quality%20of%20Care&ts_caption=Provider%20Quality%20of%20Care%20Status"
Enter "Selenium" into the "users_ac_txt" autocomplete
