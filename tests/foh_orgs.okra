Begin "Validate that the Better Corp. EO exists"
	Open the sidemenu
	Click the "Employer Organizations" sidemenu entry
	Type "Better Corp" in the "name" input
	Click the "Search" button
	Click the "Better Corp" link
	Click the "Overview (EO)" charttab
	Begin "Test the Employer Organization - Overview (EO) page"
		Verify exists "Better Corp" contactcard
		Verify exists "Search Name" text
		Verify exists @xpath='//span[text()="Search Name:"]/following-sibling::span[text()="Better Corp."]'
		Begin "Editing Employer Organization Dynamic Section"
			Open the "Employer Organization" dynamicsection
			Verify exists "Better Corp" text
			Verify exists "Employer Organization" in the "Chart Types" dynamicsection
Begin "Validate Department of Defense EO"
	Open the sidemenu
	Click the "Employer Organizations" sidemenu entry
	Type "Department of Defense" in the "name" input
	Click the "Search" button
	Click the "Department of Defense" link
	Begin "Test the Employer Organization - Overview (EO) page"
		Verify exists "Department of Defense" contactcard
		Verify exists "Search Name" text
		Verify exists @xpath='//span[text()="Search Name:"]/following-sibling::span[text()="Department of Defense (DOD)"]'
		Begin "Editing Employer Organization Dynamic Section"
			Open the "Employer Organization" dynamicsection
			Verify exists "Department of Defense" text
			Verify exists "DOD" text
			Verify exists "Employer Organization" in the "Chart Types" dynamicsection
		Begin "Verify Department of Defense Sub-Employer Organizations"
			Verify exists "910 AW - Youngstown ARB" text in the "Chart Types" dynamicsection
			Verify exists "Army National Guard" text in the "Chart Types" dynamicsection
			Verify exists "Defense Commissary Agency" text in the "Chart Types" dynamicsection
