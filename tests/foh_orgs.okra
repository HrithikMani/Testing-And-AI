Begin "Validate Department of Homeland Security EO"
	Open the sidemenu
	Click the "Employer Organizations" sidemenu entry
	Type "Department of Homeland Security" in the "name" input
	Click the "Search" button
	Click the "Department of Homeland Security" link
	Begin "Test the Employer Organization - Overview (EO) page"
		Verify exists "Department of Homeland Security" contactcard
		Verify exists "Search Name" text
		Verify exists @xpath='//span[text()="Search Name:"]/following-sibling::span[text()="Department of Homeland Security (DHS)"]'
		Begin "Editing Employer Organization Dynamic Section"
			Open the "Employer Organization" dynamicsection
			Verify exists "Department of Homeland Security" text
			Verify exists "DHS" text
			Verify exists "Employer Organization" in the "Chart Types" dynamicsection
		Begin "Verify Department of Defense Sub-Employer Organizations"
			Verify exists "Federal Emergency Management Agency" text in the "Chart Types" dynamicsection
			Verify exists "Federal Law Enforcement Training Center" text in the "Chart Types" dynamicsection
			Verify exists "Transportation Security Administration" text in the "Chart Types" dynamicsection
			Verify exists "Federal Protective Service" text in the "Chart Types" dynamicsection
			Verify exists "Immigration and Customs Enforcement" text in the "Chart Types" dynamicsection
			Verify exists "Plum Island Animal Disease Center" text in the "Chart Types" dynamicsection
			Verify exists "U.S. Citizenship and Immigration Services" text in the "Chart Types" dynamicsection
			Verify exists "U.S. Customs and Border Protection" text in the "Chart Types" dynamicsection
			Verify exists "U.S. Secret Service" text in the "Chart Types" dynamicsection
			Verify exists "United States Coast Guard" text in the "Chart Types" dynamicsection
			Verify exists "Employer Organization" in the "Chart Types" dynamicsection
