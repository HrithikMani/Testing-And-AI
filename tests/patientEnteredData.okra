Begin Add Data to DB
	@Add PHH Document@driver.miedb.dbExec("INSERT INTO documents (pat_id, doc_type) VALUES (18, 'PHH')")
	@Add observations@driver.miedb.dbExec('INSERT INTO observations (pat_id, obs_code, obs_name, obs_result) VALUES (18, (SELECT obs_code FROM observation_codes where obs_name = "PHH Hypertension"), "PHH Hypertension", "Yes"),(18, (SELECT obs_code FROM observation_codes where obs_name = "PHH Diabetes"), "PHH Diabetes", "Yes"),(18, (SELECT obs_code FROM observation_codes where obs_name = "IMM Have you had a pneumonia vaccine?"), "IMM Have you had a pneumonia vaccine?", "No"),(18, (SELECT obs_code FROM observation_codes where obs_name = "IMM Have you had a flu vaccine?"), "IMM Have you had a flu vaccine?", "Yes"),(18, (SELECT obs_code FROM observation_codes where obs_name = "FH Cancer"), "FH Cancer", "Yes"),(18, (SELECT obs_code FROM observation_codes where obs_name = "FH Heart Disease"), "FH Heart Disease", "No"),(18, (SELECT obs_code FROM observation_codes where obs_name = "SCH Tobacco Use"), "SCH Tobacco Use", "Former"),(18, (SELECT obs_code FROM observation_codes where obs_name = "SCH Alcohol Use"), "SCH Alcohol Use", "No"),(18, (SELECT obs_code FROM observation_codes where obs_name = "SH Back Surgery"), "SH Back Surgery", "No"),(18, (SELECT obs_code FROM observation_codes where obs_name = "SH Appendectomy"), "SH Appendectomy", "Yes")')

Begin Check Encounter
	Navigate "?f=chart&s=pat&pat_id=18"
	Open the quicklink list
	Click the "Add Visit" quicklink
	@Wait for the dynamic encounter section to open@driver.wcutils.waitForAJAX(30)
	Verify exists @Patient/Employee Entered link in PMH section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past Medical History")]/following-sibling::*//a[contains(., "Patient Entered")]|//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past Medical History")]/following-sibling::*//a[contains(., "Employee Entered")]'
	Verify exists @PHH Hypertension: Yes in PMH section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past Medical History")]/following-sibling::*//*[contains(., "PHH Hypertension: Yes")]'
	Verify exists @PHH Diabetes: Yes in PMH section"@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past Medical History")]/following-sibling::*//*[contains(., "PHH Diabetes: Yes")]'
	Verify exists @Patient/Employee Entered link in Past procedures section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past procedures")]/following-sibling::*//a[contains(., "Patient Entered")]|//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past procedures")]/following-sibling::*//a[contains(., "Employee Entered")]'
	Verify exists @SH Back Surgery: No in Past procedures section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past procedures")]/following-sibling::*//*[contains(., "SH Back Surgery: No")]'
	Verify exists @SH Appendectomy: Yes in Past procedures section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Past procedures")]/following-sibling::*//*[contains(., "SH Appendectomy: Yes")]'
	Verify exists @Patient/Employee Entered link in Immunizations section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Immunizations / Injections")]/following-sibling::*//a[contains(., "Patient Entered")]|//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Immunizations / Injections")]/following-sibling::*//a[contains(., "Employee Entered")]'
	Verify exists @IMM Have you had a pneumonia vaccine?: No in Injections/Immunizations section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Immunizations / Injections")]/following-sibling::*//*[contains(., "IMM Have you had a pneumonia vaccine?: No")]'
	Verify exists @IMM Have you had a flu vaccine?: Yes in Injections/Immunizations section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Immunizations / Injections")]/following-sibling::*//*[contains(., "IMM Have you had a flu vaccine?: Yes")]'
	Verify exists @Patient/Employee Entered link in Social history section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Social history")]/following-sibling::*//a[contains(., "Patient Entered")]|//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Social history")]/following-sibling::*//a[contains(., "Employee Entered")]'
	Verify exists @SCH Tobacco Use: Former in Social history section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Social history")]/following-sibling::*//*[contains(., "SCH Tobacco Use: Former")]'
	Verify exists @SCH Alcohol Use: No in Social history section@xpath='//div[contains(@class, "wc-enc-dynamic-section")]/*[contains(@class, "exam_tab") and contains(., "Social history")]/following-sibling::*//*[contains(., "SCH Alcohol Use: No")]'
