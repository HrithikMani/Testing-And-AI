Begin "Login"
Open the sidemenu
Click the "Control Panel" sidemenu entry
Begin "Set the 2FA system settings"
	Begin "Exercise the Enable 2FA system setting to create it"
		Open "My Settings" charttab
		Wait for page
		Click the @"Setup" text@xpath=//td[text()='2 Step Verification']/following-sibling::td/span[text()='Setup']
		Verify exists the "Setup 2 Step Verification" popup
		Close the popup
	Begin "Enable only HOTP"
		Click the "System" charttab
		Click the "System Settings" charttab subtab
		Wait for page
		Type "Use 2FA" in the input
		Click the "Go" button
		Click the @"Edit" link in the "Use 2FA" row@xpath=//td[contains(.,'Use 2FA')]/following-sibling::td//a[text()='Edit']
		# 1 turns on HOTP only
		Wait for page
		Type "1" in the "Value" input
		Type "login_2fa.okra" in the "Reason" input
		Click the "Change" button
		Wait for page
	Begin "Set the testing OTP URL"
		# Add this one instead of exercising it - exercising it would polute the production argus DB
		# (as that is the default for the setting) and we don't want to do that.
		Click the "Add System Setting" link
		Type "OTP Validation URL!" in the autocomplete
		Wait for page
		Click the "WebChart, Login, OTP Validation URL" autocomplete choice
		# port 8125 is the test server
		Wait for page
		Type "https://argus.med-web.com:8125/" in the "Value" input
		Type "login_2fa.okra" in the "Reason" input
		Click the "Add" button
		Verify exists the "Successfully modified system setting with module (WebChart), section (Login) and item (OTP Validation URL)" text
		Type "OTP Validation URL" in the "select_text" input
		Click the "Go" button
		# in the "Value" cell in the "Show Quantity In AutoComplete" row in the "System Settings" table
		Verify exists the !"8125" text
Begin "Verify the User View interface"
	Open "Access" charttab
	Click the "Access Control" charttab subtab
	Wait for page
	Type "Nurse" in the input
	Select "Exact" in the 1st dropdown
	Select "Username" in the 2nd dropdown
	Click the "Go!" button
	Wait for page
	Gridclick "Username:nurse" "nurse" grid link
	@Switch Windows@driver.switchToPopup()
	# in the "Two Step Verification" row
	Verify exists the "Not Enabled" text
	@Switch Windows@driver.closePopup()
Begin "Enable 2 Step for the User"
	Open "My Settings" charttab
	Begin "the 2 Step Verification row"
		Verify exists the "Not Enabled Setup" text
		Wait for page
		Click the @"Setup" text@xpath=//td[text()='2 Step Verification']/following-sibling::td/span[text()='Setup']
		Begin "the Setup 2 Step Verification MIEWindow"
			Verify exists the "Setup 2 Step Verification" popup
			Verify !exists the "We're sorry, we are currently unable to create your 2-Step Verification key." popup message
			# The System Setting specifed HOTP only
			Begin "Verify we skipped the setup screen"
				Verify !exists the "Time Based" labelledradio
				Verify !exists the "Counter Based" labelledradio
				Verify !exists the "Yes" labelledradio
				Verify !exists the "No" labelledradio
				Verify !exists the "Create" button
			Begin "Verify the Key was registered successfully"
				Verify exists the "Import" text
				Verify exists the "Or scan the code below with your authentication device." text
				Verify exists the "Can't scan a barcode?" text
				# This will show the text version of the key
				Click the @"Click Here" text@xpath=//span[text()='Click Here']
				Verify exists The "Counter Based or HOTP" text
				Begin "Get the key"
					# Push "Control-A" in the "Key" input
					# Push "Control-C" in the "Key" input
					@@@ Get the Key Value
						eles = driver.getElements(xpath="//input[contains(@id,'2fa_key_hex_input')]")
						for e in eles:
							return {
								'keyvalue': e.get_attribute('value')
								}
					@@@
				Begin "Find the current OTP value"
					@@@ Open a keygen utility
					url = "https://{0}/webchart/test_baseline_be_careful/otpgen.cgi".format(driver.getUserData('BE_CAREFUL_HOSTNAME'))
					driver.runJS('window.open("{}")'.format(url))
					driver.switchToPopup('OTP Generator')
					@@@
					Type "{keyvalue}" in the input
					# Set the counter value to 1
					Type 1 in the 2nd input
					Click the "Generate OTP" button
					@@@ Get the Key Value
						eles = driver.getElements(xpath="//input[@id='otp']")
						for e in eles:
							return {
								'otpvalue': e.get_attribute('value')
								}
					@@@
					@Switch back to WebChart@driver.returnToMainWindow()
				Type "{otpvalue}" in the otp_verify input
				Click the "Complete Setup" button
				Verify exists The "2 Step Verification setup is now complete." text 
				Close the popup
Begin "Check the OTP Verify Code"
	Open "Access" charttab
	Click the "Access Control" charttab subtab
	Type "selenium" in the search input
	Click the "Go!" button
	Wait for page
	Gridclick "Username:selenium" "selenium" grid link
	@Switch Windows@driver.switchToPopup()
	# in the "Two Step Verification" row
	Verify exists @Enabled (when appropriate) Verify@xpath='//span[contains(normalize-space(.), "Enabled (when appropriate) Verify")]'
	Click the "Verify" link
	Verify exists the "Verification Code" text
	@Switch Windows@driver.closePopup()
