Begin "Remove 2FA"
	Open the sidemenu
	Click the "Control Panel" sidemenu entry
	Open "My Settings" charttab
	# in the "2 Step Verification" row
	Click the @"Change" text@xpath=//td[text()='2 Step Verification']/following-sibling::td/span[text()='Change']
	Begin "the Change 2 Step Verification MIEWindow"
		Verify exists the "Change 2 Step Verification" popup
		Verify !exists the "We're sorry, we are currently unable to create your 2-Step Verification key." popup message
		Verify exists The "Disable" button 
		Verify exists The "Setup New Device" button 
		Click the "Disable" button
		Verify exists the "2 Step Verification is now disabled" text 
		Close the popup
Begin "Functionality options"
	Begin "Re-enable HOTP/TOTP"
		Click the "System" charttab
		Click the "System Settings" charttab subtab
		Wait for page
		Type "Login" in the input
		Click the "Go" button
		Wait for page
		Verify exists listview name
		Type "Use 2FA" in the input
		Click the "Go" button
		Click the @"Edit" link in the "Use 2FA" row@xpath=//td[contains(.,'Use 2FA')]/following-sibling::td//a[text()='Edit']
		@Wait for popup@driver.pause(2)
		# 3 is for HOTP and TOTP
		Wait for page
		Type "3" in the "Value" input
		Type "login_2fa.okra" in the "Reason" input
		Click the "Change" button
		Wait for page
		Open "My Settings" charttab
		Begin "the 2 Step Verification row"
			Begin "Make sure the Barcode display makes sense"
				Wait for page
				Click the @"Setup" text@xpath=//td[text()='2 Step Verification']/following-sibling::td/span[text()='Setup']
				Wait for page
				Verify exists the "Setup 2 Step Verification" popup
				Verify !exists the "We're sorry, we are currently unable to create your 2-Step Verification key." popup message
				Begin "the Setup 2 Step Verification MIEWindow"
					# clicking a 'clicked' radio button now unclicks it... make sure we click something else
					# so that clicking it won't undo the click.
					Click the "No" labelledradio
					# it will show the barcode
					Click the "Yes" labelledradio
					Click the "Counter Based" labelledradio
					Click the "Create" button
					Wait for page
					# we chose to display the barcode
					Verify exists the "Or scan the code below with your authentication device" text
					# we chose to display the barcode
					Verify exists the "Can't scan a barcode?" text
					# we chose the barcode instead of the textual key
					#Verify !exists the "Please enter the following information into your authentication device" text
					# we chose to display the barcode
					#Verify !exists the "Counter Based or HOTP" text
					# it displays the textual version
					Click the @"Click Here" text@xpath=//span[text()='Click Here']
					# we are now displaying the textual key as well as the barcode
					Verify exists the "Please enter the following information into your authentication device" text
					# we are now displaying the text as well as the barcode
					Verify exists the "Counter Based or HOTP" text
					Close the popup
			Begin "Make sure the Textual display makes sense"
				Open "My Settings" charttab
				Wait for page
				Click the @"Setup" text@xpath=//td[text()='2 Step Verification']/following-sibling::td/span[text()='Setup']
				Wait for page
				Verify exists the "Setup 2 Step Verification" popup
				Verify !exists the "We're sorry, we are currently unable to create your 2-Step Verification key." popup message
				Begin "the Setup 2 Step Verification MIEWindow"
					# it will hide the barcode
					Click the "No" labelledradio
					# force Time Based to not be clicked
					Click the "Counter Based" labelledradio
					# Now click the Time based so it doesn't unclick.
					Click the "Time Based" labelledradio
					Click the "Create" button
					Wait for page
					# we chose to hide the barcode
					#Verify !exists the "Or scan the code below with your authentication device" text
					# we chose to hide the barcode
					#Verify !exists the "Can't scan a barcode?" text
					# we chose to display the key as text instead of the barcode
					Verify exists the "Please enter the following information into your authentication device" text
					# we chose Time Based
					Verify exists the "Time Based or TOTP" text
					Close the popup
Begin "Verify turning off 2FA functions correctly"
	Begin "Disable the 2FA system setting"
		Click the "System" charttab
		Click the "System Settings" charttab subtab
		Wait for page
		Type "Login" in the input
		Click the "Go" button
		Wait for page
		Verify exists listview name
		Type "Use 2FA" in the input
		Click the "Go" button
		Click the @"Edit" link in the "Use 2FA" row@xpath=//td[contains(.,'Use 2FA')]/following-sibling::td//a[text()='Edit']
		Verify exists the "Edit System Setting" text
		Wait for page
		Type "0" in the "Value" input
		Type "login_2fa.okra" in the "Reason" input
		Click the "Change" button
		Wait for page
	Begin "Verify the 2 Step Verification row is not displayed"
		Open "My Settings" charttab
		Verify !exists the "2 Step Verification" table row
		Verify !exists the "Not Enabled Setup" text
		Verify !exists @Enabled (when appropriate) Verify@xpath='//span[contains(normalize-space(.), "Enabled (when appropriate) Verify")]'
