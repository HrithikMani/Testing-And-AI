@Add a fast task@driver.miedb.dbExec("INSERT INTO task_template SET name='Document Add Task',description='Document Add Task',notes='A document has been added.',type='document'")
@Add an owner@driver.miedb.dbExec("INSERT INTO task_template_users SET task_template_id=(SELECT task_template_id FROM task_template WHERE name='Document Add Task' ORDER BY task_template_id DESC LIMIT 1), owner_id=8, realm=''")
@Add a tasklist event@driver.miedb.dbExec("INSERT INTO tasklist_events SET wc_uuid=UNHEX('389F9347FBA511EBA7C0B82A72DD83F3'), evt_type='on_doc_add',template_name='Document Add Task',skip_is_tmp=1,where_clause='1',perform_url='',priority=1")

