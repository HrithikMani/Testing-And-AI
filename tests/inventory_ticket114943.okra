						Type "AnyManu Co" in the "inv_manufacturer3" autocomplete
				Begin "Receive an item without a manufacturer"
					Begin "Location 1"
						Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc4']
						@Wait@driver.wcutils.waitForAJAX(30)
						Verify "value=0" "inv_stockpile_id4" dropdown
						Enter "Strattera" into the "inv_acval4" autocomplete
						Blur the "inv_acval4" autocomplete
						@Wait@driver.wcutils.waitForAJAX(30)
