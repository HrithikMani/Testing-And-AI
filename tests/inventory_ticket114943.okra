Begin "Testing editing of lot information"
	Begin "The Easy one - Single Use Lots"
		Open the sidemenu
		Click the "Inventory" sidemenu entry
		Begin "View all records"
			Select "All" in the "ib.location" dropdown
			Click the "Search" button
		Click the @"Edit" Link in the diphenhydramine row@xpath=//td[contains(.,'diphenhydramine')]/following-sibling::td/a[contains(.,'Edit')]
		Begin "Make changes to the lot information"
			Type "afosodl1198" in the "Lot Number" input
			Type "Medique Inc" in the "Manufacturer" input
			Enter "05-01-2030" in the exp_date date
			Type "Lot Correction" in the Comment input
			Click the "Save" button
		Verify exists the "Successfully Updated Inventory Item" text
		Begin "View the updated record"
			Select "All" in the "ib.location" dropdown
			Click the "Search" button
		Verify exists the @"afosodl1198" in the "diphenhydramine" row with the updated manufacturer and expiration date@xpath=//td[contains(.,'diphenhydramine')]/following-sibling::td[contains(.,'afosodl1198')]/following-sibling::td[contains(.,'Medique Inc')]/following-sibling::td[contains(.,'05-01-2030')]
	Begin "More Complicated - Single Lot Record, Multiple locations"
		Click the @"Edit" link in the "lisinopril 5 mg tablet" in the "Office" row@xpath=//td[contains(.,'lisinopril 5 mg tablet')]/following-sibling::td[contains(.,'Office')]/following-sibling::td/a[contains(.,'Edit')]
		Begin "Make changes to the lot information"
			Type "abc123a" in the "Lot Number" input
			Type "SomeManu Corp" in the "Manufacturer" input
			Enter "02-01-2030" in the exp_date date
			Type "Lot Correction" in the Comment input
			Click the "Save" button
		Verify exists the "Successfully Updated Inventory Item" text
		Verify exists the @"abc123a" in the "lisinopril 5 mg tablet" row with the updated manufacturer and expiration date@xpath=//td[contains(.,'lisinopril 5 mg tablet')]/following-sibling::td[contains(.,'abc123a')]/following-sibling::td[contains(.,'SomeManu Corp')]/following-sibling::td[contains(.,'02-01-2030')]
		Begin "Verify the other lots did not change"
			Begin "View the other records"
				Select "All" in the "ib.location" dropdown
				Click the "Search" button
			Verify exists the @"abc123" in the "lisinopril 5 mg tablet" row with the original manufacturer and expiration date@xpath=//td[contains(.,'lisinopril 5 mg tablet')]/following-sibling::td[contains(.,'abc123')]/following-sibling::td[contains(.,'SomeManu Co')]/following-sibling::td[contains(.,'01-01-2030')]
	Begin "Edge Cases"
		Begin "Single Use Lot"
			Begin "Setup"
				Click the "Add Inventory" charttab
				Begin "Receive an item without a manufacturer or expiration"
					Select "Office" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc0']
					Verify !exists @the "Stockpile" dropdown in the "Site" cell@xpath=//select[@name='inv_stockpile_id0']
					Enter "Lipitor" into the "inv_acval0" autocomplete
					Blur the "inv_acval0" autocomplete
					@Wait@driver.wcutils.waitForAJAX(30)
					Click the "tablet 20mg" autocomplete choice
					Type "20" in the "inv_quantity0" input
					Type "lipi" in the "inv_lot_id0_vis" autocomplete
					screenshot "presave1"
				Begin "Receive an item without an expiration"
					Select "Office" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc1']
					Verify !exists @the "Stockpile" dropdown in the "Site" cell@xpath=//select[@name='inv_stockpile_id1']
					Enter "Entresto" into the "inv_acval1" autocomplete
					Blur the "inv_acval1" autocomplete
					@Wait@driver.wcutils.waitForAJAX(30)
					Click the "tablet 24-26mg" autocomplete choice
					Type "20" in the "inv_quantity1" input
					Type "entr" in the "inv_lot_id1_vis" autocomplete
					Type "AnyManu Co" in the "inv_manufacturer1" autocomplete
					screenshot "presave2"
				Begin "Receive an item without a manufacturer"
					Select "Office" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc2']
					Verify !exists @the "Stockpile" dropdown in the "Site" cell@xpath=//select[@name='inv_stockpile_id2']
					Enter "Plavix" into the "inv_acval2" autocomplete
					Blur the "inv_acval2" autocomplete
					@Wait@driver.wcutils.waitForAJAX(30)
					Click the "tablet 75mg" autocomplete choice
					Type "20" in the "inv_quantity2" input
					Type "lipi" in the "inv_lot_id2_vis" autocomplete
					Enter "01-01-2030" in the "inv_exp_date2" date
					screenshot "presave3"
				Begin "Receive an item with only a manufacturer"
					Select "Office" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc3']
					Verify !exists @the "Stockpile" dropdown in the "Site" cell@xpath=//select[@name='inv_stockpile_id3']
					Enter "Calphron" into the "inv_acval3" autocomplete
					Blur the "inv_acval3" autocomplete
					@Wait@driver.wcutils.waitForAJAX(30)
					Click the "tablet 667mg" autocomplete choice
					Type "20" in the "inv_quantity3" input
					Type "MyManu Co" in the "inv_manufacturer3" autocomplete
					screenshot "presave4"
				Click the "Add to Inventory" button
				Verify exists the "Receiving Lipitor 20 mg tablet" text
				Verify exists the "Receiving Entresto 24 mg-26 mg table" text
				Verify exists the "Receiving Plavix 75 mg tablet" text
				Verify exists the "Receiving Calphron 667 mg tablet" text
				Click the "Show Inventory" charttab
			Begin "Lot Number, no manufacturer or Expiration"
				Click the @"Edit" link in the "Lipitor" row"@xpath=//td[contains(.,'Lipitor')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Update the Lot information"
					Type "lipi01" in the "Lot Number" input
					Type "LiMed" in the "Manufacturer" input
					Enter "01-01-2030" in the "exp_date" date
					Type "Lot Update" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Verify exists the @"lip01" text in the "Lipitor" row with updated info@xpath=//td[contains(.,'Lipitor')]/following-sibling::td[contains(.,'lipi01')]/following-sibling::td[contains(.,'LiMed')]/following-sibling::td[contains(.,'01-01-2030')]
			Begin "Lot Number + Manufacturer, No Expiration"
				Click the @"Edit" link in the "Entresto" row"@xpath=//td[contains(.,'Entresto')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Update the Lot information"
					Type "entr01" in the "Lot Number" input
					Type "EntMed" in the "Manufacturer" input
					Enter "01-01-2030" in the "exp_date" date
					Type "Lot Update" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Verify exists the @"entr01" text in the "Entresto" row with the updated info@xpath=//td[contains(.,'Entresto')]/following-sibling::td[contains(.,'entr01')]/following-sibling::td[contains(.,'EntMed')]/following-sibling::td[contains(.,'01-01-2030')]
			Begin "Lot Number + Expiration, No Manufacturer"
				Click the @"Edit" link in the "Plavix" row"@xpath=//td[contains(.,'Plavix')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Update the Lot information"
					Type "plav01" in the "Lot Number" input
					Type "PlavMed" in the "Manufacturer" input
					Enter "06-01-2030" in the "exp_date" date
					Type "Lot Update" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Verify exists the @"plav01" text in the "Plavix" row with the updated info@xpath=//td[contains(.,'Plavix')]/following-sibling::td[contains(.,'plav01')]/following-sibling::td[contains(.,'PlavMed')]/following-sibling::td[contains(.,'06-01-2030')]
			Begin "Manufacturer Only"
				Click the @"Edit" link in the "Calphron" row"@xpath=//td[contains(.,'Calphron')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Update the Lot information"
					Type "calph01" in the "Lot Number" input
					Type "CalMed" in the "Manufacturer" input
					Enter "06-01-2030" in the "exp_date" date
					Type "Lot Update" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Verify exists the @"calph01" text in the "Calphron" row with the updated info@xpath=//td[contains(.,'Calphron')]/following-sibling::td[contains(.,'calph01')]/following-sibling::td[contains(.,'CalMed')]/following-sibling::td[contains(.,'06-01-2030')]
		Begin "Single Lot Record, Multiple Locations"
			Begin "Setup"
				Click the "Add Inventory" charttab
				Begin "Receive an item without a manufacturer or expiration"
					Begin "Location 1"
						Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc0']
						@Wait@driver.wcutils.waitForAJAX(30)
						Verify "value=0" "inv_stockpile_id0" dropdown
						Enter "Ambien" into the "inv_acval0" autocomplete
						Blur the "inv_acval0" autocomplete
						@Wait@driver.wcutils.waitForAJAX(30)
						Click the "tablet 5mg" autocomplete choice
						Type "20" in the "inv_quantity0" input
						Type "ambo" in the "inv_lot_id0_vis" autocomplete
					Begin "Location 2"
						Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc1']
						@Wait@driver.wcutils.waitForAJAX(30)
						Select "Store Room A" from the "inv_stockpile_id1" dropdown
						Verify "value=1" "inv_stockpile_id1" dropdown
						Enter "Ambien" into the "inv_acval1" autocomplete
						Blur the "inv_acval1" autocomplete
						@Wait@driver.wcutils.waitForAJAX(30)
						Click the "tablet 5mg" autocomplete choice
						Type "20" in the "inv_quantity1" input
						Type "ambo" in the "inv_lot_id1_vis" autocomplete
				Begin "Receive an item without an expiration"
					Begin "Location 1"
						Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc2']
						@Wait@driver.wcutils.waitForAJAX(30)
						Verify "value=0" "inv_stockpile_id2" dropdown
