				Verify exists the @new lot information@xpath=//td[contains(.,'Reglan')]/following-sibling::td[text()='Hospital: Store Room A']/following-sibling::td[contains(.,'regla01')]/following-sibling::td[contains(.,'RegMed')]/following-sibling::td[contains(.,'05-01-2030')]/following-sibling::td[contains(.,'Edit')]
		Begin "Non-medications"
			Begin "Setup"
				Click the "Control" charttab
				Begin "Create a new item"
					Click the "Add an Item" link
					Type "Stomach Tube" in the "New Name" input
					Click the "Add Item" button
					Verify exists the "Inventory Item (0027) Added Successfully" text
				Begin "Create a second new item"
					Click the "Add an Item" link
					Type "Fingertip Bandage" in the "New Name" input
					Click teh "Add Item" button
					Verify exists the "Inventory Item (0028) Added Successfully" text
				Begin "Receive the Items"
					Click the "Add Inventory" charttab
					Begin "Receive Tubes"
						Select "Office" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc0']
						Verify !exists @the "Stockpile" dropdown in the "Site" cell@xpath=//select[@name='inv_stockpile_id0']
						Enter "Stomach Tube" into the "inv_acval0" autocomplete
						Blur the "inv_acval0" autocomplete
