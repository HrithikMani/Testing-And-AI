						@Wait@driver.wcutils.waitForAJAX(30)
						Click the "tablet 10mg" autocomplete choice
						Type "20" in the "inv_quantity7" input
						Type "MyManu Co" in the "inv_manufacturer7" autocomplete
				Click the "Add to Inventory" button
				Verify exists the "Receiving Ambien 5 mg tablet" text
				Verify exists the 2nd "Receiving Ambien 5 mg tablet" text
				Verify exists the "Receiving Glucophage 850 mg tablet" text
				Verify exists the 2nd "Receiving Glucophage 850 mg tablet" text
				Verify exists the "Receiving Strattera 10 mg capsule" text
				Verify exists the 2nd "Receiving Strattera 10 mg capsule" text
				Verify exists the "Receiving Reglan 10 mg tablet" text
				Verify exists the 2nd "Receiving Reglan 10 mg tablet" text
				Click the "Show Inventory" charttab
			Begin "Lot Number, no manufacturer or Expiration"
				Begin "View the Ambien Items"
					Type "Ambien" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Click the @"Edit" link in the "Store Room A" row@xpath=//td[contains(.,'Store Room A')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Modify the Lot Information"
					Type "ambi01" in the "Lot Number" input
					Type "AmbiMed" in the "Manufacturer" input
					Enter "06-01-2030" in the "exp_date" date
					Type "Updated Lot" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Begin "View the Ambien Items"
					Type "Ambien" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Verify exists the @original lot information@xpath=//td[contains(.,'Ambien')]/following-sibling::td[text()='Hospital']/following-sibling::td[contains(.,'ambo')]/following-sibling::td[contains(.,'')]/following-sibling::td[contains(.,'')]/following-sibling::td[contains(.,'Edit')]
				Verify exists the @new lot information@xpath=//td[contains(.,'Ambien')]/following-sibling::td[text()='Hospital: Store Room A']/following-sibling::td[contains(.,'ambi01')]/following-sibling::td[contains(.,'AmbiMed')]/following-sibling::td[contains(.,'06-01-2030')]/following-sibling::td[contains(.,'Edit')]
			Begin "Lot Number + Manufacturer, No Expiration"
				Begin "View the Glucophage Items"
					Type "Glucophage" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Click the @"Edit" link in the "Store Room A" row@xpath=//td[contains(.,'Store Room A')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Modify the Lot Information"
					Type "gluco01" in the "Lot Number" input
					Type "GlucoMed" in the "Manufacturer" input
					Enter "02-01-2030" in the "exp_date" date
					Type "Updated Lot" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Begin "View the Glucophage Items"
					Type "Glucophage" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Verify exists the @original lot information@xpath=//td[contains(.,'Glucophage')]/following-sibling::td[text()='Hospital']/following-sibling::td[contains(.,'glec')]/following-sibling::td[contains(.,'AnyManu Co')]/following-sibling::td[contains(.,'')]/following-sibling::td[contains(.,'Edit')]
				Verify exists the @new lot information@xpath=//td[contains(.,'Glucophage')]/following-sibling::td[text()='Hospital: Store Room A']/following-sibling::td[contains(.,'gluco01')]/following-sibling::td[contains(.,'GlucoMed')]/following-sibling::td[contains(.,'02-01-2030')]/following-sibling::td[contains(.,'Edit')]
			Begin "Lot Number + Expiration, No Manufacturer"
				Begin "View the Strattera Items"
					Type "Strattera" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Click the @"Edit" link in the "Store Room A" row@xpath=//td[contains(.,'Store Room A')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Modify the Lot Information"
					Type "stratt01" in the "Lot Number" input
					Type "StratMed" in the "Manufacturer" input
					Enter "07-01-2030" in the "exp_date" date
					Type "Updated Lot" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Begin "View the Strattera Items"
					Type "Strattera" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Verify exists the @original lot information@xpath=//td[contains(.,'Strattera')]/following-sibling::td[text()='Hospital']/following-sibling::td[contains(.,'strot')]/following-sibling::td[contains(.,'')]/following-sibling::td[contains(.,'01-01-2030')]/following-sibling::td[contains(.,'Edit')]
				Verify exists the @new lot information@xpath=//td[contains(.,'Strattera')]/following-sibling::td[text()='Hospital: Store Room A']/following-sibling::td[contains(.,'stratt01')]/following-sibling::td[contains(.,'StratMed')]/following-sibling::td[contains(.,'07-01-2030')]/following-sibling::td[contains(.,'Edit')]
			Begin "Manufacturer Only"
				Begin "View the Reglan Items"
					Type "Reglan" in the "display" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Click the @"Edit" link in the "Store Room A" row@xpath=//td[contains(.,'Store Room A')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Modify the Lot Information"
