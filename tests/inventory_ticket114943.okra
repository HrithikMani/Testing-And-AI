						Type "20" in the "inv_quantity4" input
						Type "strot" in the "inv_lot_id4_vis" autocomplete
						Enter "01-01-2030" in the "inv_exp_date4" date
					Begin "Location 2"
						Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc5']
						@Wait@driver.wcutils.waitForAJAX(30)
						Select "Store Room A" from the "inv_stockpile_id5" dropdown
