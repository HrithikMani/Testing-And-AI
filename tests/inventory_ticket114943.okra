					Begin "Location 2"
						Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc7']
						@Wait@driver.wcutils.waitForAJAX(30)
						Select "Store Room A" from the "inv_stockpile_id7" dropdown
