				Verify exists the @"XT9C" text in the "Stomach Tube" row and other updated info@xpath=//td[contains(.,'Stomach Tube')]/following-sibling::td[contains(.,'AM32C')]/following-sibling::td[contains(.,'McTubes Inc.')]/following-sibling::td[contains(.,'05-01-2030')]
			Begin "Multi-Location Lot"
				Type "Fingertip Bandage" in the "display_name" input
				Select "All" in the "ib.location" dropdown
				Click the "Search" button
				Begin "Update the Lot"
					Click the @"Edit" link in the "Store Room A" row@xpath=//td[contains(.,'Fingertip Bandage')]/following-sibling::td[contains(.,'Hospital: Store Room A')]/following-sibling::td/a[contains(.,'Edit')]
					Begin "Enter new Lot information"
						Type "X97T" in the "Lot Number" input
						Type "TipMart" in the "Manufacturer" input
						Enter "03-01-2030" in the exp_date date
						Type "Updated Lot" in the "Comment" input
						Click the "Save" button
					Verify exists the "Successfully Updated Inventory Item" text
				Begin "View the items"
					Type "Fingertip Bandage" in the "display_name" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
				Verify exists the @original lot information@xpath=//td[contains(.,'Fingertip Bandage')]/following-sibling::td[text()='Hospital']/following-sibling::td[contains(.,'XT9C')]/following-sibling::td[contains(.,'')]/following-sibling::td[contains(.,'06-01-2030')]/following-sibling::td[contains(.,'Edit')]
				Verify exists the @new lot information@xpath=//td[contains(.,'Fingertip Bandage')]/following-sibling::td[text()='Hospital: Store Room A']/following-sibling::td[contains(.,'X97T')]/following-sibling::td[contains(.,'TipMart')]/following-sibling::td[contains(.,'03-01-2030')]/following-sibling::td[contains(.,'Edit')]
	Begin "Re-use of lot"
		Begin "Setup"
			Click the "Add Inventory" charttab
			Begin "Receive an existing item"
				Select "Hospital" in the @dropdown in the "Site" cell@xpath=//select[@name='inv_transloc2']
				@Wait@driver.wcutils.waitForAJAX(30)
				Select "Store Room B" from the "inv_stockpile_id2" dropdown
				Enter "Fingertip Bandage" into the "inv_acval2" autocomplete
				Blur the "inv_acval2" autocomplete
				Type "20" in the "inv_quantity2" input
				Type "XT9C" in the "inv_lot_id2_vis" autocomplete
				Enter "06-01-2030" in the "inv_exp_date2" date
				screenshot "presavenr3"
				Click the "Add to Inventory" button
				Verify exists the "Receiving Fingertip Bandage (20)" text
		Begin "Edit the Lot Information"
			Click the "Show Inventory" charttab
			Begin "Show the item"
				Type "Fingertip Bandage" in the "display_name" input
				Select "All" in the "ib.location" dropdown
				Click the "Search" button
			Begin "Update the Lot"
				Click the @"Edit" link in the "Store Room A" row@xpath=//td[contains(.,'Fingertip Bandage')]/following-sibling::td[contains(.,'Hospital: Store Room B')]/following-sibling::td/a[contains(.,'Edit')]
				Begin "Enter new Lot information"
					Type "X97T" in the "Lot Number" input
					Type "TipMart" in the "Manufacturer" input
					Enter "03-01-2030" in the exp_date date
					Type "Updated Lot" in the "Comment" input
					Click the "Save" button
				Verify exists the "Successfully Updated Inventory Item" text
				Begin "View the items"
					Type "Fingertip Bandage" in the "display_name" input
					Select "All" in the "ib.location" dropdown
					Click the "Search" button
			Verify exists the @new lot information@xpath=//td[contains(.,'Fingertip Bandage')]/following-sibling::td[text()='Hospital: Store Room B']/following-sibling::td[contains(.,'X97T')]/following-sibling::td[contains(.,'TipMart')]/following-sibling::td[contains(.,'03-01-2030')]/following-sibling::td[contains(.,'Edit')]
			Verify exists the @same lot_id in the "Hospital: Store Room A" and "Hospital: Store Room B" "Edit" links@xpath=//td[contains(.,'Hospital: Store Room B')]/following-sibling::td/a[contains(@href,concat('&lot_id=',substring-before(substring-after(substring-after(string(//td[contains(.,'Hospital: Store Room A')]/following-sibling::td/a[contains(.,'Edit')]/@href),'?'),'lot_id='),'&'),'&'))]

