Begin "Employee Portal"
	Begin "Homepage"
		Click the "Better Corp." link
		Verify exists @Notification Bell@id='portal-header-notify'
		Screenshot First Visit
		Click the @id="modal-close"
		Screenshot Employee Homepage

	Begin "Travel Questionnaire"
		Click the @id='portal-user-menu-top'
		Click the @xpath='//a/span[contains(text(), "Travel Questionnaire")]'
		Verify exists @Notification Bell@id='portal-header-notify'
		Screenshot Travel Questionnaire
		@Scroll Next button into View @driver.runJS("document.evaluate(`//button[contains(.,'NEXT')]`, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.scrollIntoView();")
		Click the "NEXT" button
		Verify exists "No to all" text
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Streptomycin: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Neomycin: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Eggs: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Yeast: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Thermisol/Mercury: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Gelatin: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Aluminum: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Formaldehyde: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="2-Phenoxyethanol: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Polymycin: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Bee stings: No"]'
		Verify !exists @xpath='//div[contains(@class, "portal-mask") and contains(@class, "fade-mask")]'
		@Wait 1 seconds@driver.pause(1)
		Click the @xpath='//span[text()="No to all"]/..'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Streptomycin: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Neomycin: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Eggs: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Yeast: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Thermisol/Mercury: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Gelatin: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Aluminum: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Formaldehyde: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="2-Phenoxyethanol: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Polymycin: No"]'
		Verify exists @xpath='//div[contains(@class, "checked")]/span/input[@aria-label="Bee stings: No"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Streptomycin: Yes"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Neomycin: Yes"]'
		Verify exists @xpath='//div[not(contains(@class, "checked"))]/span/input[@aria-label="Eggs: Yes"]'
