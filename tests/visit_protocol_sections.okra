Begin Check Financials Encounter Section
	@Scroll the section into view@driver.runJS('jQuery("h3:contains(Financials)")[0].scrollIntoView()')
	Open "Financials" dynamicsection
	Verify exists @Charges grid@xpath='//div[@class="wcdv_grid"]/div[contains(@class, "wcdv_grid_titlebar")]/strong[contains(., "Charges")]'
	Close "Financials" dynamicsection
