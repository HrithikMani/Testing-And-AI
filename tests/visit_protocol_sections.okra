Begin Check Visual Exam Encounter Section
	@Scroll the section into view@driver.runJS('jQuery("h3:contains(Physical exam)")[0].scrollIntoView()')
	Click "Visual Exam" button
	@Wait for the dynamic encounter section to open@driver.wcutils.waitForAJAX(30)
	@Scroll the section into view@driver.runJS('jQuery("h3:contains(Visual exam)")[0].scrollIntoView()')
	Screenshot "VisExam"
	Verify exists "Visual Exam Findings" text
	Type "20/20" into obs_result_416_0 input
	Close "Visual exam" dynamicsection
	Verify exists @xpath='//div[contains(.,"Visual Exam Findings")]/following-sibling::div[contains(.,"20/20")]'

Begin Check Symptoms/Diagnosis Encounter Section
	@Scroll the section into view@driver.runJS('jQuery("h3:contains(Symptoms / Diagnosis)")[0].scrollIntoView()')
	Open "Symptoms / Diagnosis" dynamicsection
	Verify exists "Assessment Narrative:" text
	Type "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Faucibus nisl tincidunt eget nullam non." into ImpressionNotes input
	Close "Symptoms / Diagnosis" dynamicsection
	Verify exists "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Faucibus nisl tincidunt eget nullam non." text

Begin Check Clinical Education Encounter Section
	@Scroll the section into view@driver.runJS('jQuery("h3:contains(Clinical education)")[0].scrollIntoView()')
	Open "Clinical education" dynamicsection

	Verify exists "Clinical education material given" text
	Verify exists "Clinical Education Comments" text

	Click "DECB_Patient education material given" checkbox
	Type "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Faucibus nisl tincidunt eget nullam non." into obs_result_419_0 input
	Close "Clinical education" dynamicsection

	Verify exists "Clinical education material given." text
	Verify exists @xpath='//div[contains(.,"Clinical Education Comments")]/following-sibling::div[contains(.,"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Faucibus nisl tincidunt eget nullam non.")]'

