@Setup to allow date ranges on entry actions@driver.miedb.dbExec("INSERT INTO system_settings (module, section, item, value) VALUES ('WebChart', 'Health Surveillance', 'Use Date Range for Entry Actions', '1') ON DUPLICATE KEY UPDATE value='1'")

Begin "Time Travel to Late Winter"
	Navigate "?tabmodule=admin&tabselect=Health+Surveillance&f=panelactiontest&s=time_machine"
	Enter "03-16-2017" in the date
	Click the "Submit" button

Begin "Add WARM and COLD Panel Memberships for William Hart"
	Navigate "?f=chart&s=pat&t=Admin%3APanel+Membership+Overview&v=dashboard&pat_id=18"
	Select "Cold Weather" from the "pm_extra_panel" dropdown
	Click the "Submit" button
	Select "Warm Weather" from the "pm_extra_panel" dropdown
	Click the "Submit" button
	Click the "HSPPM_E_COLD_18_check" checkbox
	Click the "HSPPM_E_WARM_18_check" checkbox
	Click the "Submit" button
	@Wait for the date to be calculated before navigating away@driver.pause(5)
	Verify exists "Next: 01-15-2018" text
	Verify exists "Next: 05-16-2017" text

Begin "Make sure WARM panel doesn't trigger too soon"
	Navigate "?tabmodule=admin&tabselect=Health+Surveillance&f=panelactiontest&s=time_machine"
	Enter "03-24-2017" in the date
	Click the "Submit" button
	Navigate "?f=panelactiontest&tabmodule=admin&tabselect=HSP"
	Enter "Hart, William" in the "pat_id" autocomplete
	Click the "Evaluate" button
	Verify !exists "due: 08-15-2017" text

Begin "Make sure WARM panel triggers mid-season"
	Navigate "?tabmodule=admin&tabselect=Health+Surveillance&f=panelactiontest&s=time_machine"
	Enter "07-01-2017" in the date
	Click the "Submit" button
	Enter "Hart, William" in the "pat_id" autocomplete
	Click the "Evaluate" button
	@Wait for the date to be calculated before navigating away@driver.pause(5)
	Verify exists "due: 08-15-2017" text

