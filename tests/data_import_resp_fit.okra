Begin "Import file"
	Open the sidemenu
	Click "Control Panel" sidemenu entry
	Click the Interface charttab
	Click the "Data import" charttab subtab
	Wait for the "DataImportTypes" grid
	Click the "Show/Hide Grid Controls" icon
	Select "Name" from the @Filters dropdown@xpath='//span[contains(., "Filters")]/parent::div/following-sibling::div/select[@class="wcdv_control_addField"]'
	Sumoselect "Respirator Fit Test Data CSV API" from the "Name" grid sumoselect
	Click the "OK" grid sumobutton
	Wait for ajax
	Click "Respirator Fit Test Data CSV API" grid checkbox
	Click the "Upload Data" button
	Verify exists @xpath="//div[@class='wc_win']"
	Verify exists "Respirator Fit Test Data CSV API" text in @xpath="//div[@class='wc_win']"
	Screenshot "test"
	Click the "DI_Verbose" checkbox
	@Wait@driver.pause(1)
	Type 'RespFitImportSuccess.csv' in the 'csv_file' input
	Click the "Upload File" button
	@driver.getWebDriver().switch_to.frame("di_output_frame")
	@Wait@driver.pause(1)
	Verify exists "Successfully imported file RespFitImportSuccess.csv!" text
	@driver.getWebDriver().switch_to.parent_frame()
	Click the @Close button@xpath='//button[@class="xclose"]'
Begin "Validate Respirator Fit values"
	Begin "Check values for William Hart"
		Verify exists sidemenu
		Open the sidemenu
		Click "E-Chart" sidemenu entry
		Click the " EMP #" radio
		Type "10019" in the "sstring" input
		Click the "Search" button
		Verify exists "TEST-10019" text
		Click the "Health Surveillance" charttab
		Click the "Respirator Info" charttab subtab
		Verify exists "Pass - Full Face large on 03-14-2006" text
	Begin "Check values for Jennifer Pregnant"
		Verify exists sidemenu
		Open the sidemenu
		Click "E-Chart" sidemenu entry
		Click the " EMP #" radio
		Type "10021" in the "sstring" input
		Click the "Search" button
		Verify exists "TEST-10021" text
		Click the "Health Surveillance" charttab
		Click the "Respirator Info" charttab subtab
		Verify exists "Pass - Full Face medium on 02-14-2005" text