Begin "Start with no inventory permissions"
	Begin "Revoke general inventory permissions"
		Open the sidemenu
		Click the "Control Panel" sidemenu entry
		Click the "Access" charttab
		Click the "Access Control" charttab subtab
		Type "selenium" in the input
		Click the "Go!" button
		Gridclick "Username:selenium" "Edit" grid link
		Click the "Customize User Security" link
		Select "No" in the "View Inventory" dropdown
		Select "No" in the "Transfer Inventory" dropdown
		Select "No" in the "Expire Inventory" dropdown
		Select "No" in the "Edit Inventory" dropdown
		Type "inventory_view.vision" in the securityrole reason
		Click the "Update Individual Security" button
		# in the "Access Control (selenium)" box
		Verify exists the "[ View Inventory: No ]" text
		Verify exists the "[ Transfer Inventory: No ]" text
		Verify exists the "[ Expire Inventory: No ]" text
		Verify exists the "[ Edit Inventory: No ]" text
	Begin "Verify the complete lack of permission"
		Open the sidemenu
		Click the "Inventory" sidemenu entry
		Verify exists the "Your current permission of 'No' in the ('Inventory','View Inventory') security setting does not allow access to View Inventory." text
		Verify !exists the "General Inventory" table
Begin "Regain View Inventory permissions"
	Begin "Grant inventory View access"
		Open the sidemenu
		Click the "Control Panel" sidemenu entry
		Click the "Access" charttab
		Click the "Access Control" charttab subtab
		Type "selenium" in the input
		Click the "Go!" button
		Gridclick "Username:selenium" "Edit" grid link
		Click the "Customize User Security" link
		Select "Yes" in the "View Inventory" dropdown
		Type "inventory_view.vision" in the securityrole reason
		Click the "Update Individual Security" button
		# in the "Access Control (selenium)" box
		Verify !exists the "[ View Inventory: No ]" text
		Verify exists the "[ Transfer Inventory: No ]" text
		Verify exists the "[ Expire Inventory: No ]" text
		Verify exists the "[ Edit Inventory: No ]" text
	Begin "Verify permission level"
		Open the sidemenu
		Click the "Inventory" sidemenu entry
		# in the "General Inventory" table
		Verify !exists the "!Edit" link
		Verify !exists the "Expire" link
		Verify !exists the "Transfer" link
