"""
    Workflow test for webscan add batch window
    @owners: dcornewell, sgrider
    @filedeps: system/layouts/MIEWebScan/AddBatchWin.html, system/layouts/MIEWebScan/AddBatchWinOptions.html
"""
Open the sidemenu
Click the WebScan sidemenu entry
Click the "Add Batch" link
Verify exists "Upload" popup
Verify exists "Scan" button
Verify exists "Settings" button
Click the File Upload button
Verify exists "Choose Files" button
Verify exists @Disabled "Upload Scanned File" button@xpath='//input[contains(@value, "Upload Scanned File") and @disabled]'
Verify exists @Disabled "Clear List" button@xpath='//input[contains(@value, "Clear List") and @disabled]'

Begin "Setup Enable Clinic Location for Batch Processes System Setting"
	Close popup
	Open the sidemenu
	Click "Control Panel" sidemenu entry
	Click "System" charttab
	Click "System Settings" charttab subtab
	Click "Add System Setting" link
	Enter "Enable Clinic Location for Batch Processes" in the "settings_query" autocomplete
	@Wait@driver.wcutils.waitForAJAX(30)
	Select "1" in the "value" dropdown
	Type "Setup Enable Clinic Location for Batch Processes System Setting" into "reason" input
	Click Add button

Begin "Test Add Batch with Clinic Location"
	Open the sidemenu
	Click the WebScan sidemenu entry
	Click the "Add Batch" link
	Verify exists "Batch Upload" popup
	Verify exists "clinic_location" autocomplete
