Begin "Make an encounter for Allison Thomas"
	Navigate "?f=chart&s=pat&pat_id=52"
	Open the quicklink list
	Click the "Add Visit" quicklink
Begin "Encounter Setup"
	@Wait for the dynamic encounter to settle@driver.wcutils.waitForAJAX(30)
	@wait for growl@driver.waitFor(driver, lambda d: d.getElement(xpath='//div[@class="growl-message"]'), expected_return=False, timeout=60)
Begin "Scroll to the Presenting meds section"
	Toggle the "Smart Plan" quicklist
# This next step is unstable, you may see "BG tasks mask is present"
	Toggle the "Presenting medications" quicklist
Begin "Add a detailed medication"
	Type "Other" in the "Presenting medications" quicklist search
	# This is slow. Why?
	Add "Presenting medications: Quick List" "Other" quicklist item
	Click the "Show All Details" button
	Enter "lisinopril" in the "Medication" autocomplete
	Enter "tablet 10mg" in the "Form" autocomplete
	Type "1 tab qd" in the "Practitioner Sig" input
	Click the "30d" button
	Type "30" in the "Total Quantity" input
	Select "Tablet" from the "Total Quantity" dropdown
	Click the "11" button
	Click the 2nd "Save" popup button
Begin "Add a bunch of name-only medications"
	Add "Presenting medications: Quick List" "Other" quicklist item
	Enter "Zoloft" in the "Medication" autocomplete
	Click the 2nd "Save" popup button
	Add "Presenting medications: Quick List" "Other" quicklist item
	Enter "Lipitor" in the "Medication" autocomplete
	Click the 2nd "Save" popup button
#	Other medications for later planned testing...
#	Add "Presenting medications: Quick List" "Other" quicklist item
#	Enter "Zocor" in the "Medication" autocomplete
#	Click the 2nd "Save" popup button
#	Add "Presenting medications: Quick List" "Other" quicklist item
#	Enter "levothyroxine" in the "Medication" autocomplete
#	Click the 2nd "Save" popup button
#	Add "Presenting medications: Quick List" "Other" quicklist item
#	Enter "metformin" in the "Medication" autocomplete
