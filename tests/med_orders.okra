#	Enter "albuterol" in the "Medication" autocomplete
#	Click the 2nd "Save" popup button
#	Add "Presenting medications: Quick List" "Other" quicklist item
#	Enter "fluticasone" in the "Medication" autocomplete
#	Click the 2nd "Save" popup button
#	Add "Presenting medications: Quick List" "Other" quicklist item
#	Enter "Lasix" in the "Medication" autocomplete
#	Click the 2nd "Save" popup button
Begin "Show the Smark Plan quicklist"
	Toggle the "Presenting medications" quicklist
	Open the "Smart Plan" dynamicsection
	Close the "Smart Plan" dynamicsection
	@Allow zeus to meditate@driver.pause(30)
Begin "Refill a detailed med"
	Type "lisin" in the "Smart Plan" quicklist search
	Refill the "lisinopril" quicklist item
	Select "Butler, Internist E." from the "Prescriber" dropdown
	@Scroll last input into view@driver.runJS('document.getElementsByName("pharm_note")[0].scrollIntoView(true)')
	Click the "None" labelledradio
	Click the "Save" popup button
	Verify exists "Refill lisinopril 10 mg tablet, Dur: 30d, Qty: 30 Tablet, Ref: 11, May Substitute" text
Begin "Change-Refill an undetailed med"
	Type "Zol" in the "Smart Plan" quicklist search
	ChangeTherapy the "Zoloft" quicklist item
	Click the "Refill" labelledradio
	Enter "tablet 50mg" in the "Form" autocomplete
	Type "1 tab bid" in the "Practitioner Sig" input
	Click the "90d" button
	@Scroll last input into view@driver.runJS('document.getElementsByName("pharm_note")[0].scrollIntoView(true)')
	Select "Butler, Internist E." from the "Prescriber" dropdown
	Click the "None" labelledradio
	Click the "Save" popup button
	Verify exists "Refill Zoloft 50 mg tablet, Sig:1 tab bid, Dur: 90d, Qty: 180 Tablet, Ref: 0" text
Begin "Change-Increase an undetailed med"
	Type "lipi!" in the "Smart Plan" quicklist search
	ChangeTherapy the "Lipitor" quicklist item
	Click the "Increase" labelledradio
	Enter "tablet 80mg" in the "Form" autocomplete
	Type "1 tab qd" in the "Practitioner Sig" input
	Type "30d" in the "Duration" input
	@Scroll last input into view@driver.runJS('document.getElementsByName("pharm_note")[0].scrollIntoView(true)')
	Select "Butler, Internist E." from the "Prescriber" dropdown
	Click the "None" labelledradio
	Click the "Save" popup button
	Verify exists "Increase Lipitor 80 mg tablet, Sig:1 tab qd, Dur: 30d, Qty: 30 Tablet, Ref: 0, May Substitute" text