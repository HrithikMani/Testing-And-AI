Begin "Import file"
	Open the sidemenu
	Click "Control Panel" sidemenu entry
	Click the Interface charttab
	Click the "Data import" charttab subtab
	Wait for the "DataImportTypes" grid
	Click the "Show/Hide Grid Controls" icon
	Select "Name" from the @Filters dropdown@xpath='//span[contains(., "Filters")]/parent::div/following-sibling::div/select[@class="wcdv_control_addField"]'
	Sumoselect "Injections CSV API" from the "Name" grid sumoselect
	Click the "OK" grid sumobutton
	Wait for ajax
	Click "Injections CSV API" grid checkbox
	Click the "Upload Data" button
	Verify exists @xpath="//div[@class='wc_win']"
	Verify exists "Injections CSV API" text in @xpath="//div[@class='wc_win']"
	Screenshot "test"
	Click the "DI_Verbose" checkbox
	@Wait@driver.pause(1)
	Type 'InjectDataImportSuccess.csv' in the 'csv_file' input
	Click the "Upload File" button
	@driver.getWebDriver().switch_to.frame("di_output_frame")
	@Wait@driver.pause(1)
	Verify exists "Successfully imported file InjectDataImportSuccess.csv!" text
	@driver.getWebDriver().switch_to.parent_frame()
	Click the @Close button@xpath='//button[@class="xclose"]'
Begin "Verify Entries"
	Begin "Jane Doe Injections"
		Verify exists sidemenu
		Open the sidemenu
		Click "E-Chart" sidemenu entry
		Click the "Name" radio
		Type "Doe, Jane" in the "sstring" input
		Click the "Search" button
		Verify exists "Doe, Jane M" link
		Click the "Medical Record" charttab
		Click the "MAR/Injections" charttab subtab
		Verify exists "DTP-Hib-Hep B" listview link
		Verify exists "IPV" listview link
		Verify exists "poliovirus vaccine, inactivated" listview link
	Begin "William Hart Injections"
		Verify exists sidemenu
		Open the sidemenu
		Click "E-Chart" sidemenu entry
		Click the "Name" radio
		Type "Hart" in the "sstring" input
		Click the "Search" button
		Verify exists "TEST-10019" link
		Click the "TEST-10019" link
		Click the "Medical Record" charttab
		Click the "MAR/Injections" charttab subtab
		Verify exists "Influenza, split (incl. purified surface antigen)" listview link
		Verify exists "Hep B, adolescent or pediatric" listview link
		Verify exists "DTaP-Hep B-IPV" listview link