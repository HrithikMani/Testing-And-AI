Begin "Go to William Hart's Chart"
	Open the sidemenu
	Click the "E-Chart" sidemenu entry
	Click the "TEST-10019" link
Begin "Order an Audiogram"
	Click the "Add Visit" link
	Open the "Tests & procedures" dynamicsection
	Close the "Tests & procedures" dynamicsection
	Click the "In House Testing Pick List" icon
	Click the "Audiogram" picklist checkbox
	Click the "Add Procedures" button
	Begin "Enter Audiograms"
		Open the "Audiogram" dynamicsection
		Begin "Enter first test"
			Wait for ajax
			Click the New button
			@Wait for audiogram inputs@driver.waitFor(driver, lambda d: d.getElement(xpath='//input[@id="left05active" and not(@disabled)]'), timeout=90)
			Verify value="" @id=left05active
			Type "5" in the @Left 500 Active field@xpath=//input[@id="left05active"]
			Type "5" in the @Left 1k Active field@xpath=//input[@id="left1active"]
			Type "5" in the @Left 2k Active field@xpath=//input[@id="left2active"]
			Type "5" in the @Left 3k Active field@xpath=//input[@id="left3active"]
			Type "5" in the @Left 4k Active field@xpath=//input[@id="left4active"]
			Type "5" in the @Left 6k Active field@xpath=//input[@id="left6active"]
			Type "5" in the @Left 8k Active field@xpath=//input[@id="left8active"]
			Type "5" in the @Right 500 Active field@xpath=//input[@id="right05active"]
			Type "5" in the @Right 1k Active field@xpath=//input[@id="right1active"]
			Type "5" in the @Right 2k Active field@xpath=//input[@id="right2active"]
			Type "5" in the @Right 3k Active field@xpath=//input[@id="right3active"]
			Type "5" in the @Right 4k Active field@xpath=//input[@id="right4active"]
			Type "5" in the @Right 6k Active field@xpath=//input[@id="right6active"]
			Type "5" in the @Right 8k Active field@xpath=//input[@id="right8active"]
			Type "12345" in the @Device Number field@xpath=//input[@id="audioSerial"]
			Enter "05-01-2004 1350" into the "Test Date" date
			Enter "05-01-2004" into the "Calibration Date" date
			Click the Save button
			Verify exists "Successfully saved Audio test" popup
			Close the popup
			Verify "value=12345" @xpath=//input[@id='audioSerial']
		Begin "Set baseline"
			Click the "Edit" button
# See Ticket #134793 "Check" and "Uncheck" Okra verbs do not check/uncheck the correct checkboxes in audio_manual.okra
#			Check the left_baseline0 checkbox
			Click the left_baseline0 checkbox
# See Ticket #134793 "Check" and "Uncheck" Okra verbs do not check/uncheck the correct checkboxes in audio_manual.okra
#			Check the right_baseline0 checkbox
			Click the right_baseline0 checkbox
			Click the Save button
			Verify exists "Successfully saved Audio test" popup
			Close the popup
		Begin "Enter second test"
			Wait for ajax
			Click the "New" button
			@Wait for audiogram inputs@driver.waitFor(driver, lambda d: d.getElement(xpath='//input[@id="left05active" and not(@disabled)]'), timeout=90)
			Verify value="" @id=left05active
			Type "10" in the @Left 500 Active field@xpath=//input[@id="left05active"]
			Type "10" in the @Left 1k Active field@xpath=//input[@id="left1active"]
			Type "10" in the @Left 2k Active field@xpath=//input[@id="left2active"]
			Type "10" in the @Left 3k Active field@xpath=//input[@id="left3active"]
			Type "10" in the @Left 4k Active field@xpath=//input[@id="left4active"]
			Type "10" in the @Left 6k Active field@xpath=//input[@id="left6active"]
			Type "10" in the @Left 8k Active field@xpath=//input[@id="left8active"]
			Type "10" in the @Right 500 Active field@xpath=//input[@id="right05active"]
			Type "10" in the @Right 1k Active field@xpath=//input[@id="right1active"]
			Type "10" in the @Right 2k Active field@xpath=//input[@id="right2active"]
			Type "10" in the @Right 3k Active field@xpath=//input[@id="right3active"]
			Type "10" in the @Right 4k Active field@xpath=//input[@id="right4active"]
			Type "10" in the @Right 6k Active field@xpath=//input[@id="right6active"]
			Type "10" in the @Right 8k Active field@xpath=//input[@id="right8active"]
			Enter "05-01-2005 1350" into the "Test Date" date
			Enter "05-01-2005" into the "Calibration Date" date
			Click the Save button
			Verify exists "Successfully saved Audio test" popup
			Close the popup
		Begin "Enter third test"
			Wait for ajax
			Click the "New" button
			@Wait for audiogram inputs@driver.waitFor(driver, lambda d: d.getElement(xpath='//input[@id="left05active" and not(@disabled)]'), timeout=90)
			Verify value="" @id=left05active
			Type "15" in the @Left 500 Active field@xpath=//input[@id="left05active"]
			Type "15" in the @Left 1k Active field@xpath=//input[@id="left1active"]
			Type "15" in the @Left 2k Active field@xpath=//input[@id="left2active"]
			Type "15" in the @Left 3k Active field@xpath=//input[@id="left3active"]
			Type "15" in the @Left 4k Active field@xpath=//input[@id="left4active"]
			Type "15" in the @Left 6k Active field@xpath=//input[@id="left6active"]
			Type "15" in the @Left 8k Active field@xpath=//input[@id="left8active"]
			Type "15" in the @Right 500 Active field@xpath=//input[@id="right05active"]
			Type "15" in the @Right 1k Active field@xpath=//input[@id="right1active"]
			Type "15" in the @Right 2k Active field@xpath=//input[@id="right2active"]
			Type "15" in the @Right 3k Active field@xpath=//input[@id="right3active"]
			Type "15" in the @Right 4k Active field@xpath=//input[@id="right4active"]
			Type "15" in the @Right 6k Active field@xpath=//input[@id="right6active"]
			Type "15" in the @Right 8k Active field@xpath=//input[@id="right8active"]
			Enter "05-01-2006 1350" into the "Test Date" date
			Enter "05-01-2006" into the "Calibration Date" date
		Begin "Confirm an STS"
			Click the Save button
			Verify exists "An STS (Standard Threshold Shift) has been detected" popup message
			Close the popup
			Verify exists "Successfully saved Audio test" popup message
			Close the popup
		Begin "Set new Baseline"
			Click the "Edit" button
# See Ticket #134793 "Check" and "Uncheck" Okra verbs do not check/uncheck the correct checkboxes in audio_manual.okra
#			Check the left_baseline0 checkbox
			Click the left_baseline0 checkbox
# See Ticket #134793 "Check" and "Uncheck" Okra verbs do not check/uncheck the correct checkboxes in audio_manual.okra
#			Check the right_baseline0 checkbox
			Click the right_baseline0 checkbox
			Click the Save button
			Verify exists "An STS (Standard Threshold Shift) has been detected" popup message
			Close the popup
			Verify exists "Successfully saved Audio test" popup message
			Close the popup
		Begin "Enter fourth test"
			Wait for ajax
			Click the "New" button
			@Wait for audiogram inputs@driver.waitFor(driver, lambda d: d.getElement(xpath='//input[@id="left05active" and not(@disabled)]'), timeout=90)
			Verify value="" @id=left05active
			Type "20" in the @Left 500 Active field@xpath=//input[@id="left05active"]
			Type "20" in the @Left 1k Active field@xpath=//input[@id="left1active"]
			Type "20" in the @Left 2k Active field@xpath=//input[@id="left2active"]
			Type "20" in the @Left 3k Active field@xpath=//input[@id="left3active"]
			Type "20" in the @Left 4k Active field@xpath=//input[@id="left4active"]
			Type "20" in the @Left 6k Active field@xpath=//input[@id="left6active"]
			Type "20" in the @Left 8k Active field@xpath=//input[@id="left8active"]
			Type "20" in the @Right 500 Active field@xpath=//input[@id="right05active"]
			Type "20" in the @Right 1k Active field@xpath=//input[@id="right1active"]
			Type "20" in the @Right 2k Active field@xpath=//input[@id="right2active"]
			Type "20" in the @Right 3k Active field@xpath=//input[@id="right3active"]
			Type "20" in the @Right 4k Active field@xpath=//input[@id="right4active"]
			Type "20" in the @Right 6k Active field@xpath=//input[@id="right6active"]
			Type "20" in the @Right 8k Active field@xpath=//input[@id="right8active"]
			Enter "05-01-2007 1350" into the "Test Date" date
			Enter "05-01-2007" into the "Calibration Date" date
		Begin "Verify not an STS"
			Click the Save button
			Verify exists "Successfully saved Audio test" popup
			Close the popup
			Verify !exists "An STS (Standard Threshold Shift) has been detected" popup
		Begin "Set different ear baselines"
			Click the "Edit" button
# See Ticket #134793 "Check" and "Uncheck" Okra verbs do not check/uncheck the correct checkboxes in audio_manual.okra
#			Uncheck the right_baseline1 checkbox
			Click the right_baseline1 checkbox
			Click the Save button
			Verify exists "Successfully saved Audio test" popup
		Begin "Verify test is now an STS"
			Verify exists "An STS (Standard Threshold Shift) has been detected" popup
			Close the popup
			Close the popup
	Begin "Validate Audio Document"
		Click the "Medical Record" charttab
		Click the "Audiogram" charttab subtab
		Click the "05-01-2007" link
		Verify exists "YES (13.00)" text
		Verify exists "NO (4.00)" text
		Wait for ajax
		Screenshot "Audio Document"
